CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
# Keys the daily hashes that tell requesters apart; any long random string
EVERYREPO_REQUEST_SECRET=
# Turnstile secret for the person check on requests; leave empty to skip the check
TURNSTILE_SECRET_KEY=
# Deployed sites allowed to call the API, comma separated
EVERYREPO_ALLOWED_ORIGINS=
# Set to 1 only behind a proxy that sets cf-connecting-ip or x-forwarded-for
EVERYREPO_TRUST_PROXY=
# GitHub OAuth app for signing in; its callback URL is EVERYREPO_API_URL/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where the website and this API are reached; defaults are the local preview and serve addresses
EVERYREPO_SITE_URL=
EVERYREPO_API_URL=
