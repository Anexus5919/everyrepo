<dialog class="diagram-modal" aria-labelledby="diagram-modal-title" data-diagram-modal>
  <div class="modal-shell">
    <header class="modal-head">
      <div class="modal-heading">
        <h2 id="diagram-modal-title">Import links</h2>
        <p class="legend">
          <span class="legend-item"
            ><svg width="34" height="10" viewBox="0 0 34 10" aria-hidden="true"
              ><path d="M1 5H28" class="legend-line"></path><path d="M26 1L32 5L26 9z" class="legend-head"
              ></path></svg
            >points to the file being imported</span
          >
          <span class="legend-item"
            ><svg width="34" height="10" viewBox="0 0 34 10" aria-hidden="true"
              ><path d="M1 5H28" class="legend-line dashed"></path><path
                d="M26 1L32 5L26 9z"
                class="legend-head"></path></svg
            >loops back to a file further left</span
          >
        </p>
      </div>
      <div class="zoom" role="group" aria-label="Zoom">
        <button type="button" data-zoom="out" aria-label="Zoom out">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"
            ><path d="M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
            ></path></svg
          >
        </button>
        <span class="zoom-level mono" data-zoom-level>100%</span>
        <button type="button" data-zoom="in" aria-label="Zoom in">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"
            ><path d="M3 8h10M8 3v10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
            ></path></svg
          >
        </button>
        <button type="button" class="fit" data-zoom="fit">Fit</button>
      </div>
      <button class="close" type="button" aria-label="Close" data-modal-close>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
          ><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
          ></path></svg
        >
      </button>
    </header>

    <div class="modal-body">
      <div class="stage" tabindex="-1" data-stage>
        <div class="stage-inner diagram is-modal" data-stage-inner></div>
        <p class="stage-hint">Drag to move, scroll to zoom, click a file to see its links</p>
      </div>
      <aside class="inspector" aria-live="polite" data-inspector></aside>
    </div>
  </div>
</dialog>

<script>
  const modal = document.querySelector<HTMLDialogElement>("[data-diagram-modal]");
  if (modal) {
    const stage = modal.querySelector<HTMLElement>("[data-stage]")!;
    const inner = modal.querySelector<HTMLElement>("[data-stage-inner]")!;
    const inspector = modal.querySelector<HTMLElement>("[data-inspector]")!;
    const level = modal.querySelector<HTMLElement>("[data-zoom-level]")!;
    let scale = 1;
    let x = 0;
    let y = 0;
    let naturalWidth = 0;
    let naturalHeight = 0;
    let selected: string | null = null;
    let labels = new Map<string, string>();
    let edges: Array<{ from: string; to: string }> = [];

    const escape = (text: string) =>
      text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    function apply() {
      inner.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
      level.textContent = `${Math.round(scale * 100)}%`;
    }

    // Layout sizes are used rather than on-screen boxes, which shrink while the window animates open
    function fit() {
      const roomWidth = stage.clientWidth;
      const roomHeight = stage.clientHeight;
      if (roomWidth === 0 || naturalWidth === 0) return;
      scale = Math.min((roomWidth - 64) / naturalWidth, (roomHeight - 96) / naturalHeight, 1.6);
      x = (roomWidth - naturalWidth * scale) / 2;
      y = (roomHeight - naturalHeight * scale) / 2 - 12;
      apply();
    }

    // Zooming keeps the point under the pointer, or the centre, where it was
    function zoomAt(factor: number, clientX?: number, clientY?: number) {
      const room = stage.getBoundingClientRect();
      const px = (clientX ?? room.left + room.width / 2) - room.left;
      const py = (clientY ?? room.top + room.height / 2) - room.top;
      const next = Math.min(3, Math.max(0.25, scale * factor));
      x = px - ((px - x) * next) / scale;
      y = py - ((py - y) * next) / scale;
      scale = next;
      apply();
    }

    function listItems(ids: string[]) {
      if (ids.length === 0) return `<p class="empty">None among these files</p>`;
      return `<ul>${ids
        .map((id) => {
          const label = labels.get(id) ?? id;
          const name = label.split("/").pop() ?? label;
          return `<li><button type="button" data-select="${id}"><span class="mono">${escape(name)}</span><span class="folder">${escape(label.split("/").slice(0, -1).join("/"))}</span></button></li>`;
        })
        .join("")}</ul>`;
    }

    function render() {
      const svg = inner.querySelector("svg");
      if (!svg) return;
      const linked = new Set<string>(selected ? [selected] : []);
      svg.querySelectorAll<SVGPathElement>(".edge").forEach((edge) => {
        const on = selected !== null && (edge.dataset.from === selected || edge.dataset.to === selected);
        edge.classList.toggle("is-linked", on);
        if (on) {
          linked.add(edge.dataset.from!);
          linked.add(edge.dataset.to!);
        }
      });
      svg.querySelectorAll<SVGGElement>(".node").forEach((node) => {
        node.classList.toggle("is-linked", linked.has(node.dataset.node!));
        node.classList.toggle("is-selected", node.dataset.node === selected);
      });
      inner.classList.toggle("is-focused", selected !== null);

      if (selected === null) {
        const degree = (id: string) => edges.filter((edge) => edge.from === id || edge.to === id).length;
        const ids = [...labels.keys()].sort((a, b) => degree(b) - degree(a));
        inspector.innerHTML = `<span class="inspector-label">Files in this diagram</span><p class="inspector-note">Files on the left use the files on their right. Pick one to follow its links.</p>${listItems(ids)}`;
        return;
      }
      const label = labels.get(selected) ?? selected;
      const imports = edges.filter((edge) => edge.from === selected).map((edge) => edge.to);
      const importedBy = edges.filter((edge) => edge.to === selected).map((edge) => edge.from);
      inspector.innerHTML = `<button type="button" class="back" data-select="">All files</button>
        <h3 class="mono">${escape(label.split("/").pop() ?? label)}</h3>
        <span class="path mono">${escape(label)}</span>
        <span class="inspector-label">Imports <span class="count">${imports.length}</span></span>${listItems(imports)}
        <span class="inspector-label">Imported by <span class="count">${importedBy.length}</span></span>${listItems(importedBy)}`;
    }

    function select(id: string | null) {
      selected = id;
      render();
    }

    function open(figure: HTMLElement, nodeId: string | null) {
      const source = figure.querySelector(".diagram-scroll svg");
      if (!source) return;
      const svg = source.cloneNode(true) as SVGSVGElement;
      // The copy gets its own arrow marker so it does not depend on the page diagram
      svg.querySelector("marker")?.setAttribute("id", "arrow-modal");
      svg.querySelectorAll(".edge").forEach((edge) => edge.setAttribute("marker-end", "url(#arrow-modal)"));
      svg.removeAttribute("style");
      svg.querySelectorAll(".node").forEach((node) => node.removeAttribute("tabindex"));
      inner.replaceChildren(svg);
      naturalWidth = Number(source.getAttribute("width"));
      naturalHeight = Number(source.getAttribute("height"));
      labels = new Map(
        [...svg.querySelectorAll<SVGGElement>(".node")].map((node) => [
          node.dataset.node!,
          node.querySelector("title")?.textContent ?? "",
        ]),
      );
      edges = [...svg.querySelectorAll<SVGPathElement>(".edge")].map((edge) => ({
        from: edge.dataset.from!,
        to: edge.dataset.to!,
      }));
      modal!.showModal();
      stage.focus({ preventScroll: true });
      fit();
      requestAnimationFrame(fit);
      select(nodeId);
    }

    document.querySelectorAll<HTMLElement>("[data-diagram]").forEach((figure) => {
      figure.addEventListener("click", (event) => {
        const node = (event.target as Element).closest<SVGGElement>(".node");
        open(figure, node?.dataset.node ?? null);
      });
      figure.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        const node = (event.target as Element).closest<SVGGElement>(".node");
        event.preventDefault();
        open(figure, node?.dataset.node ?? null);
      });
    });

    modal.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === modal) {
        modal.close();
        return;
      }
      if (target.closest("[data-modal-close]")) modal.close();
      const zoom = target.closest<HTMLElement>("[data-zoom]")?.dataset.zoom;
      if (zoom === "in") zoomAt(1.25);
      if (zoom === "out") zoomAt(0.8);
      if (zoom === "fit") fit();
      const pick = target.closest<HTMLElement>("[data-select]");
      if (pick) select(pick.dataset.select || null);
    });

    modal.addEventListener("keydown", (event) => {
      if (event.target instanceof HTMLInputElement) return;
      if (event.key === "+" || event.key === "=") zoomAt(1.25);
      if (event.key === "-") zoomAt(0.8);
      if (event.key === "0") fit();
    });

    stage.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();
        zoomAt(event.deltaY < 0 ? 1.12 : 0.89, event.clientX, event.clientY);
      },
      { passive: false },
    );

    // Dragging moves the drawing; a press that barely moves counts as a click on a file
    let drag: { id: number; startX: number; startY: number; x: number; y: number; moved: boolean } | null =
      null;
    stage.addEventListener("pointerdown", (event) => {
      drag = { id: event.pointerId, startX: event.clientX, startY: event.clientY, x, y, moved: false };
      try {
        stage.setPointerCapture(event.pointerId);
      } catch {
        // Without capture the drag still follows moves over the stage
      }
    });
    stage.addEventListener("pointermove", (event) => {
      if (!drag || drag.id !== event.pointerId) return;
      const dx = event.clientX - drag.startX;
      const dy = event.clientY - drag.startY;
      if (!drag.moved && Math.hypot(dx, dy) < 4) return;
      drag.moved = true;
      stage.classList.add("is-dragging");
      x = drag.x + dx;
      y = drag.y + dy;
      apply();
    });
    stage.addEventListener("pointerup", (event) => {
      if (!drag || drag.id !== event.pointerId) return;
      const moved = drag.moved;
      drag = null;
      stage.classList.remove("is-dragging");
      if (moved) return;
      const hit = document.elementFromPoint(event.clientX, event.clientY)?.closest<SVGGElement>(".node");
      select(hit?.dataset.node === selected ? null : (hit?.dataset.node ?? null));
    });

    new ResizeObserver(() => {
      if (modal.open) fit();
    }).observe(stage);
  }
</script>

<style is:global>
  .diagram-modal {
    width: min(96vw, 1500px);
    height: min(92svh, 960px);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raise);
    color: var(--text);
    box-shadow: var(--shadow);
  }

  .diagram-modal::backdrop {
    background: rgba(8, 7, 6, 0.62);
    backdrop-filter: blur(3px);
  }

  /* The window grows out of the diagram it was opened from */
  .diagram-modal[open] {
    animation: modal-open 220ms var(--ease-out);
  }

  @keyframes modal-open {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  .modal-shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100%;
  }

  .modal-head {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 14px 16px 14px 22px;
    border-bottom: 1px solid var(--line-soft);
  }

  .modal-heading {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    margin-right: auto;
  }

  .modal-heading h2 {
    font-size: var(--t-h4);
    line-height: 1.2;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .legend-line {
    stroke: var(--text-3);
    stroke-width: 1.4;
    fill: none;
  }

  .legend-line.dashed {
    stroke-dasharray: 4 3;
  }

  .legend-head {
    fill: var(--text-3);
  }

  .zoom {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .zoom button,
  .close {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 30px;
    padding: 0 8px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    font-size: var(--t-caption);
    color: var(--text-2);
    cursor: pointer;
  }

  .zoom button:hover,
  .close:hover {
    background: var(--panel-2);
    color: var(--text);
  }

  .zoom-level {
    min-width: 48px;
    font-size: var(--t-label);
    text-align: center;
    color: var(--text-3);
  }

  .close {
    height: 38px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .modal-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    min-height: 0;
  }

  .stage {
    position: relative;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    background:
      radial-gradient(circle, var(--line-soft) 1px, transparent 1.2px) 0 0 / 22px 22px,
      var(--bg);
  }

  .stage:focus {
    outline: none;
  }

  .stage.is-dragging {
    cursor: grabbing;
  }

  .stage-inner {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
  }

  .reader .diagram.is-modal {
    width: max-content;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    overflow: visible;
  }

  .reader .diagram.is-modal svg {
    display: block;
    max-width: none;
    margin: 0;
  }

  .reader .diagram.is-modal .node {
    cursor: pointer;
  }

  .reader .diagram.is-modal .node.is-selected rect {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .stage-hint {
    position: absolute;
    left: 16px;
    bottom: 12px;
    padding: 4px 10px;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: var(--bg-raise);
    font-size: var(--t-label);
    color: var(--text-3);
    pointer-events: none;
  }

  .inspector {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 0;
    padding: 18px 16px;
    border-left: 1px solid var(--line-soft);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .inspector h3 {
    font-size: var(--t-small);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .inspector .path {
    margin-bottom: 8px;
    font-size: var(--t-label);
    color: var(--text-3);
    overflow-wrap: anywhere;
  }

  .inspector-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .inspector-label .count {
    padding: 0 6px;
    border-radius: 999px;
    background: var(--panel-2);
    letter-spacing: 0;
    color: var(--text-2);
  }

  .inspector-note {
    font-size: var(--t-caption);
    line-height: 1.55;
    color: var(--text-2);
  }

  .inspector ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .inspector li button {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 7px 10px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .inspector li button:hover {
    background: var(--panel-2);
  }

  .inspector li .mono {
    font-size: var(--t-caption);
    color: var(--text);
  }

  .inspector li .folder {
    font-size: 11px;
    color: var(--text-3);
  }

  .inspector .empty {
    padding: 4px 10px;
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .inspector .back {
    align-self: flex-start;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    font-size: var(--t-caption);
    color: var(--text-2);
    cursor: pointer;
  }

  .inspector .back:hover {
    color: var(--text);
    border-color: var(--text-3);
  }

  @media (max-width: 820px) {
    .diagram-modal {
      width: 100vw;
      height: 100svh;
      border-radius: 0;
    }

    .modal-body {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) 38%;
    }

    .inspector {
      border-left: 0;
      border-top: 1px solid var(--line-soft);
    }

    .legend,
    .stage-hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-modal[open] {
      animation: none;
    }
  }
</style>
