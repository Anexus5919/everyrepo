---
import BookIcon from "./BookIcon.astro";
import Logo from "./Logo.astro";
import Ribbon from "./Ribbon.astro";
---

<footer class="site-footer snap">
  <Ribbon />
  <div class="frame footer-inner">
    <div class="cta">
      <span class="eyebrow">Start reading</span>
      <h2 class="cta-title">Open any public repository.</h2>
      <p class="cta-text">Paste a link. If its wiki is written, you are reading it in a second.</p>
      <a class="btn btn-solid btn-lg book-trigger" href="/#open">Open a repository <BookIcon /></a>
    </div>

    <div class="bottom">
      <div class="about">
        <a class="brand" href="/"><Logo /> EveryRepo</a>
        <p>
          A wiki for public GitHub repositories. Every sentence links to the lines of code it was
          written from.
        </p>
      </div>
      <div class="wordmark" aria-hidden="true">EveryRepo</div>
      <div class="legal">
        <span>Pages are written from public code at the commit shown on each page.</span>
        <nav class="links" aria-label="Footer">
          <a href="/#wiki">A wiki page</a>
          <a href="/#guide">Repositories</a>
          <a href="/#method">Method</a>
          <span class="mono">everyrepo.me</span>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line-soft);
    overflow: hidden;
  }

  .footer-inner {
    position: relative;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 56px;
    padding: 96px 24px 0;
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 560px;
  }

  .cta-title {
    font-size: var(--t-title);
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .cta-text {
    font-size: var(--t-small);
    color: var(--text-2);
  }

  .bottom {
    display: flex;
    flex-direction: column;
  }

  .about {
    padding-bottom: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
  }

  .about p {
    margin-top: 12px;
    max-width: 360px;
    font-size: var(--t-small);
    color: var(--text-2);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .links a {
    color: var(--text-2);
    transition: color 140ms ease;
  }

  .links a:hover {
    color: var(--text);
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: clamp(88px, 17.5vw, 232px);
    line-height: 0.78;
    font-weight: 500;
    letter-spacing: -0.045em;
    color: transparent;
    -webkit-text-stroke: 1px var(--line);
    user-select: none;
    white-space: nowrap;
    margin-left: -6px;
  }

  .legal {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0 24px;
    border-top: 1px solid var(--line-soft);
    background: var(--bg);
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  @media (max-width: 720px) {
    .footer-inner {
      padding: 64px 0 0;
    }

    .legal,
    .links {
      flex-direction: column;
      align-items: flex-start;
    }

    .links {
      gap: 10px;
    }
  }
</style>
