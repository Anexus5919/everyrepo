---
import Logo from "./Logo.astro";
import Ribbon from "./Ribbon.astro";
import { loadRepos } from "../lib/site-data.ts";

const repos = loadRepos();
const ready = repos.filter((repo) => repo.status === "ready");
const waiting = repos.filter((repo) => repo.status !== "ready");
const year = new Date().getFullYear();
---

<footer class="site-footer snap">
  <div class="panel">
    <div class="top">
      <nav class="columns" aria-label="Footer">
        <div class="column">
          <h2 class="heading">Read</h2>
          <a href="/#wiki">A wiki page</a>
          <a href="/#guide">Repositories</a>
          <a href="/#method">How a page is made</a>
          <a href="/#open">Open a repository</a>
        </div>
        <div class="column">
          <h2 class="heading">Wikis</h2>
          {
            ready.map((repo) => (
              <a class="mono" href={`/${repo.repo}`}>
                {repo.repo}
              </a>
            ))
          }
        </div>
        <div class="column">
          <h2 class="heading">Being written</h2>
          {
            waiting.map((repo) => (
              <span class="waiting">
                <span class="mono">{repo.repo}</span>
                <span class="state">{repo.status === "indexing" ? "reading" : "queued"}</span>
              </span>
            ))
          }
        </div>
      </nav>
      <div class="stream" aria-hidden="true">
        <Ribbon />
      </div>
      <a class="mark" href="/" aria-label="EveryRepo home" data-ribbon-target>
        <Logo size={44} />
      </a>
    </div>

    <div class="status-row">
      <span class="status">
        <span class="dot"></span>
        {ready.length} wikis ready to read, {waiting.length} being written
      </span>
      <div class="theme-switch" role="radiogroup" aria-label="Color theme" data-theme-switch>
        <button type="button" role="radio" data-mode="system" aria-label="Match the system">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg>
        </button>
        <button type="button" role="radio" data-mode="light" aria-label="Light">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        </button>
        <button type="button" role="radio" data-mode="dark" aria-label="Dark">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg>
        </button>
      </div>
    </div>

    <div class="legal">
      <div class="legal-text">
        <span>Pages are written from public code at the commit shown on each page.</span>
        <span>&copy; {year} EveryRepo</span>
      </div>
      <span class="tagline">Read any codebase like you already work there.</span>
    </div>

    <div class="wordmark" aria-hidden="true"><span>EveryRepo</span></div>
  </div>
</footer>

<script>
  type Mode = "system" | "light" | "dark";

  const root = document.documentElement;
  const system = window.matchMedia("(prefers-color-scheme: light)");

  const savedMode = (): Mode => {
    try {
      const saved = localStorage.getItem("theme");
      return saved === "light" || saved === "dark" || saved === "system" ? saved : "dark";
    } catch {
      return "dark";
    }
  };

  function reflect(mode: Mode) {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-switch] button").forEach((button) => {
      button.setAttribute("aria-checked", String(button.dataset.mode === mode));
    });
  }

  function apply(mode: Mode) {
    root.dataset.theme = mode === "system" ? (system.matches ? "light" : "dark") : mode;
    try {
      localStorage.setItem("theme", mode);
    } catch {
      // Storage can be blocked, so the choice lasts only for this page view
    }
    reflect(mode);
  }

  reflect(savedMode());
  document.querySelectorAll<HTMLElement>("[data-theme-switch]").forEach((group) => {
    group.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-mode]");
      if (button) apply(button.dataset.mode as Mode);
    });
  });
  system.addEventListener("change", () => {
    if (savedMode() === "system") apply("system");
  });
  // The header toggle picks light or dark directly
  window.addEventListener("themechange", () => reflect(savedMode()));
</script>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    display: flex;
    padding: 24px;
    background: var(--bg);
    border-top: 1px solid var(--line-soft);
  }

  .panel {
    position: relative;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 56px 64px 0;
    border: 1px solid var(--line-soft);
    border-radius: 20px;
    background: var(--bg-raise);
    overflow: hidden;
  }

  .top {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 48px;
    padding-bottom: 16px;
  }

  .columns {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 0 96px;
    align-items: start;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: var(--t-small);
  }

  .heading {
    margin-bottom: 6px;
    font-size: var(--t-h4);
    line-height: 1.3;
  }

  .column a {
    color: var(--text-2);
    transition: color 140ms ease;
  }

  .column a:hover {
    color: var(--text);
  }

  .column .mono {
    font-size: var(--t-caption);
  }

  .waiting {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: var(--text-3);
  }

  .state {
    font-size: var(--t-label);
    color: var(--text-3);
    opacity: 0.8;
  }

  /* The stream only uses the empty area to the right of the columns */
  .stream {
    position: absolute;
    top: -56px;
    right: -64px;
    bottom: 0;
    width: 46%;
    mask-image: linear-gradient(to right, transparent, #000 30%);
  }

  .mark {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-raise);
    color: var(--text);
    transition: border-color 160ms ease;
  }

  .mark:hover {
    border-color: var(--text-3);
  }

  /* The wordmark takes the height left in the panel, sized to fill it, and is cut off by the bottom edge */
  .wordmark {
    position: relative;
    flex: 1 1 0;
    min-height: 96px;
    container-type: size;
  }

  .wordmark span {
    position: absolute;
    left: -8px;
    bottom: -0.2em;
    font-family: var(--font-serif);
    font-size: min(20.5cqw, 136cqh);
    line-height: 0.9;
    font-weight: 500;
    letter-spacing: -0.045em;
    color: transparent;
    -webkit-text-stroke: 1px var(--line);
    user-select: none;
    white-space: nowrap;
  }

  .status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line-soft);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--t-ui);
    font-weight: 500;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent);
  }

  .theme-switch {
    display: flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .theme-switch button {
    display: grid;
    place-items: center;
    width: 32px;
    height: 28px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .theme-switch button:hover {
    color: var(--text);
  }

  .theme-switch button[aria-checked="true"] {
    background: var(--panel-2);
    color: var(--text);
  }

  .legal {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .legal-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .tagline {
    font-family: var(--font-serif);
    font-size: var(--t-h4);
    font-style: italic;
    color: var(--text-2);
  }

  @media (max-width: 1100px) {
    .stream {
      display: none;
    }

    .columns {
      gap: 32px 56px;
    }
  }

  @media (max-width: 820px) {
    .site-footer {
      padding: 12px;
    }

    .panel {
      padding: 40px 24px 0;
    }

    .top {
      flex-direction: column-reverse;
    }

    .columns {
      grid-template-columns: 1fr;
    }

    .status-row,
    .legal {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
