---
import { loadRepos } from "../lib/site-data.ts";

const ready = loadRepos().filter((repo) => repo.status === "ready");
// A short name other than the one the home page leads with keeps the drawings readable
const typed =
  [...ready].sort((a, b) => a.repo.length - b.repo.length).find((repo) => repo !== ready[0])?.repo ??
  ready[0]?.repo ??
  "owner/repo";
const question = "Where is the configuration loaded?";

const steps = [
  {
    label: "Welcome",
    title: "A wiki for any public repository",
    text: "EveryRepo reads a repository's code and writes a wiki about it: how it is organized, what each part does and where to start reading.",
  },
  {
    label: "Open a repository",
    title: "Start from its hub",
    text: "Type a name or paste a GitHub link. The hub shows what the project is, the files to open first and every section of its wiki.",
  },
  {
    label: "Citations",
    title: "Every sentence has a source",
    text: "The small numbers are citations. Point at one to see the lines it was written from, or click it to open those lines on GitHub at the same commit.",
  },
  {
    label: "Diagrams",
    title: "See how files connect",
    text: "Diagrams show which files import which. Click one to open it larger, then pick a file to follow its links.",
  },
  {
    label: "Ask",
    title: "Ask about the code",
    text: "Ask a question about a repository and get an answer written from its code, with the same citations.",
  },
];

// Monospace glyphs are 0.6em wide, so the typing cover can be sized from the text length
const cover = (text: string, size: number) => Math.ceil(text.length * size * 0.6) + 6;
