  <script is:inline type="application/json" data-guide-steps set:html={JSON.stringify(steps)} />
</dialog>

<script>
  const guide = document.querySelector<HTMLDialogElement>("[data-guide]");
  if (guide) {
    const steps = JSON.parse(guide.querySelector("[data-guide-steps]")?.textContent ?? "[]") as Array<{
      label: string;
      title: string;
      text: string;
    }>;
    const scenes = [...guide.querySelectorAll<SVGSVGElement>("[data-scene]")];
    const segments = [...guide.querySelectorAll<HTMLElement>(".segment")];
    const copy = guide.querySelector<HTMLElement>("[data-guide-copy]")!;
    const count = guide.querySelector<HTMLElement>("[data-guide-count]")!;
    const label = guide.querySelector<HTMLElement>("[data-guide-label]")!;
    const title = guide.querySelector<HTMLElement>("[data-guide-title]")!;
    const text = guide.querySelector<HTMLElement>("[data-guide-text]")!;
    const back = guide.querySelector<HTMLButtonElement>("[data-guide-back]")!;
    const next = guide.querySelector<HTMLButtonElement>("[data-guide-next]")!;
    let step = 0;

    const remember = () => {
      try {
        localStorage.setItem("guide.done", "true");
      } catch {
        // Without storage the guide simply shows again on the next visit
      }
    };

    // Each scene replays from its start whenever its step is shown
    function show(index: number) {
      step = Math.max(0, Math.min(steps.length - 1, index));
      const current = steps[step]!;
      scenes.forEach((scene, position) => {
        scene.classList.remove("is-active");
        if (position === step) {
          void scene.getBoundingClientRect();
          scene.classList.add("is-active");
        }
      });
      segments.forEach((segment, position) => segment.classList.toggle("is-done", position <= step));
      count.textContent = `${step + 1} of ${steps.length}`;
      label.textContent = current.label;
      title.textContent = current.title;
      text.textContent = current.text;
      copy.classList.remove("is-changing");
      void copy.offsetWidth;
      copy.classList.add("is-changing");
      back.hidden = step === 0;
      next.textContent = step === steps.length - 1 ? "Ok, let's get started" : "Next";
    }

    function open() {
      if (!guide!.open) guide!.showModal();
      show(0);
      next.focus();
    }

    function close() {
      remember();
      guide!.close();
    }

    next.addEventListener("click", () => (step === steps.length - 1 ? close() : show(step + 1)));
    back.addEventListener("click", () => show(step - 1));
    guide.querySelectorAll("[data-guide-skip]").forEach((button) => button.addEventListener("click", close));
    guide.addEventListener("close", remember);
    guide.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight" && step < steps.length - 1) show(step + 1);
      if (event.key === "ArrowLeft") show(step - 1);
    });

    document.addEventListener("click", (event) => {
      if ((event.target as Element).closest("[data-guide-open]")) {
        event.preventDefault();
        open();
      }
    });

    let seen = false;
    try {
      seen = localStorage.getItem("guide.done") === "true";
    } catch {
      seen = false;
    }
    if (!seen || new URLSearchParams(window.location.search).has("guide")) {
      // The page settles first so the guide opens over something to look at
      window.setTimeout(open, 700);
    }
  }
</script>

<style>
  .guide {
    width: min(680px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100svh - 32px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raise);
    color: var(--text);
    box-shadow: var(--shadow);
    overflow: hidden auto;
  }

  .guide::backdrop {
    background: rgba(8, 7, 6, 0.55);
    backdrop-filter: blur(3px);
  }

  .guide[open] {
    animation: guide-open 260ms var(--ease-out);
  }

  @keyframes guide-open {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .stage {
    position: relative;
    height: 260px;
    border-bottom: 1px solid var(--line-soft);
    background:
      radial-gradient(circle, var(--line-soft) 1px, transparent 1.2px) 0 0 / 20px 20px,
      var(--bg);
  }

  .scene {
    position: absolute;
    inset: 10px 0;
    width: 100%;
    height: calc(100% - 20px);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .scene.is-active {
    opacity: 1;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 24px 28px 22px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 132px;
  }

  .copy.is-changing {
    animation: copy-in 240ms ease-out;
  }

  @keyframes copy-in {
    from {
      opacity: 0;
    }
  }

  .step-label {
    display: flex;
    gap: 10px;
    font-size: var(--t-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .step-label .mono {
    color: var(--accent);
    letter-spacing: 0;
    text-transform: none;
  }

  .copy h2 {
    font-size: var(--t-h3);
    line-height: 1.2;
  }

  .copy p {
    max-width: 560px;
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--text-2);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .progress {
    display: flex;
    gap: 6px;
    margin-right: auto;
  }

  .segment {
    position: relative;
    width: 22px;
    height: 3px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .segment::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms var(--ease-out);
  }

  .segment.is-done::after {
    transform: scaleX(1);
  }

  .text-btn {
    height: 40px;
    padding: 0 12px;
    border: 0;
    background: transparent;
    font-size: var(--t-ui);
    color: var(--text-3);
    cursor: pointer;
  }

  .text-btn:hover {
    color: var(--text);
  }

  .guide-close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raise);
    color: var(--text-2);
    cursor: pointer;
  }

  .guide-close:hover {
    color: var(--text);
    border-color: var(--text-3);
  }

  /* Shared drawing parts */
  .card {
    fill: var(--panel);
    stroke: var(--line);
  }

  .card.back {
    opacity: 0.55;
  }

  .field {
    fill: var(--panel);
    stroke: var(--line);
  }

  .bar {
    fill: var(--line);
  }

  .bar.strong {
    fill: var(--text-3);
  }

  .chip {
    fill: var(--accent-soft);
    stroke: var(--accent-line);
  }

  .chip-text {
    font-family: var(--font-mono);
    font-size: 11px;
    text-anchor: middle;
    fill: var(--accent);
  }

  .mono-text {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--text);
  }

  .mono-text.big {
    font-size: 14px;
  }

  .mono-text.small {
    font-size: 12px;
  }

  .mono-text.tiny {
    font-size: 10px;
    fill: var(--text-2);
  }

  .mono-text.faint {
    fill: var(--text-3);
  }

  .label-text {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.08em;
    fill: var(--text-3);
  }

  .num-text,
  .line-no {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--accent);
  }

  .line-no {
    fill: var(--text-3);
  }

  .glyph,
  .icon-line {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-line.accent {
    stroke: var(--accent);
  }

  .link {
    fill: none;
    stroke: var(--accent-line);
    stroke-width: 1.5;
  }

  .rule {
    stroke: var(--line-soft);
  }

  .highlight {
    fill: var(--accent-soft);
  }

  .pill {
    fill: var(--panel-2);
    stroke: var(--line);
  }

  .type-cover {
    fill: var(--panel);
    transform-box: fill-box;
    transform-origin: right;
    transform: scaleX(0);
  }

  .send {
    fill: var(--accent);
  }

  .send-arrow {
    fill: none;
    stroke: var(--accent-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cursor {
    fill: var(--text);
    stroke: var(--bg);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .node rect {
    fill: var(--panel);
