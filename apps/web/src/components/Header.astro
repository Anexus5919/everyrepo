---
import BookIcon from "./BookIcon.astro";
import Logo from "./Logo.astro";

interface Props {
  // Reader pages span wider than the home page frame
  wide?: boolean;
}
const { wide = false } = Astro.props;
---

<header class="site-header">
  <div class:list={["bar", wide ? "wide" : "frame"]}>
    <a class="brand" href="/">
      <Logo />
      <span>EveryRepo</span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href="/#wiki">A wiki page</a>
      <a href="/#guide">Repositories</a>
      <a href="/#method">Method</a>
    </nav>
    <div class="actions">
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        aria-label="Switch between dark and light"
      >
        <svg
          class="moon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path pathLength="1" d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg
        >
        <svg
          class="sun"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle pathLength="1" cx="12" cy="12" r="4"></circle>
          <path pathLength="1" d="M12 2v2" style="--n: 0"></path>
          <path pathLength="1" d="M17.7 6.3l1.4-1.4" style="--n: 1"></path>
          <path pathLength="1" d="M20 12h2" style="--n: 2"></path>
          <path pathLength="1" d="M17.7 17.7l1.4 1.4" style="--n: 3"></path>
          <path pathLength="1" d="M12 20v2" style="--n: 4"></path>
          <path pathLength="1" d="M4.9 19.1l1.4-1.4" style="--n: 5"></path>
          <path pathLength="1" d="M2 12h2" style="--n: 6"></path>
          <path pathLength="1" d="M4.9 4.9l1.4 1.4" style="--n: 7"></path>
        </svg>
      </button>
      <a class="btn btn-solid book-trigger" href="/#open">Open a repository <BookIcon /></a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    height: var(--header);
    background: var(--header-bg);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--line-soft);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 40px;
    height: 100%;
    padding: 0 24px;
  }

  .bar.wide {
    width: min(100%, 1640px);
    margin-inline: auto;
    padding: 0 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    gap: 28px;
    font-size: var(--t-ui);
  }

  .nav a {
    color: var(--text-2);
    transition: color 140ms ease;
  }

  .nav a:hover {
    color: var(--text);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    transition:
      color 140ms ease,
      border-color 140ms ease;
  }

  .icon-btn:hover {
    color: var(--text);
    border-color: var(--text-3);
  }

  .icon-btn svg {
    grid-area: 1 / 1;
  }

  .icon-btn path,
  .icon-btn circle {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .sun {
    display: none;
  }

  :global([data-theme="light"]) .sun {
    display: block;
  }

  :global([data-theme="light"]) .moon {
    display: none;
  }

  /* After a switch the new icon draws itself: the moon as one stroke, the sun core then its rays */
  .icon-btn.switched .moon path,
  .icon-btn.switched .sun circle {
    animation: draw-in 420ms var(--ease-out) both;
  }

  .icon-btn.switched .sun path {
    animation: draw-in 240ms var(--ease-out) both;
    animation-delay: calc(260ms + var(--n) * 35ms);
  }

  @keyframes draw-in {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 820px) {
    .nav {
      display: none;
    }

    .bar {
      padding: 0;
    }
  }

  @media (max-width: 480px) {
    .actions .btn {
      display: none;
    }
  }
</style>

<script>
  import { changeTheme } from "../lib/theme.ts";

  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  toggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    changeTheme(
      next,
      () => {
        document.documentElement.dataset.theme = next;
        toggle.classList.remove("switched");
        void toggle.offsetWidth;
        toggle.classList.add("switched");
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Storage can be blocked, so the choice lasts only for this page view
        }
        window.dispatchEvent(new Event("themechange"));
      },
    );
  });
</script>
