---
import Arrow from "./Arrow.astro";
import Logo from "./Logo.astro";

interface Props {
  status?: string | undefined;
}
const { status } = Astro.props;
---

<header class="site-header">
  <div class="frame bar">
    <a class="brand" href="/">
      <Logo />
      <span>EveryRepo</span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href="/#guide">Repositories</a>
      <a href="/#wiki">A wiki page</a>
      <a href="/#method">Method</a>
    </nav>
    {status && <div class="status">{status}</div>}
    <div class="actions">
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        aria-label="Switch between dark and light"
      >
        <svg
          class="moon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg
        >
        <svg
          class="sun"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path></svg
        >
      </button>
      <a class="btn btn-solid" href="/#open">Open a repository <Arrow /></a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    height: var(--header);
    background: var(--header-bg);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--line-soft);
  }

  .bar {
    display: flex;
    align-items: stretch;
    height: 100%;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 28px 0 20px;
    border-right: 1px solid var(--line-soft);
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    align-items: stretch;
  }

  .nav a {
    display: flex;
    align-items: center;
    padding: 0 20px;
    border-right: 1px solid var(--line-soft);
    font-size: var(--t-ui);
    color: var(--text-2);
    transition:
      color 140ms ease,
      background-color 140ms ease;
  }

  .nav a:hover {
    color: var(--text);
    background: var(--bg-raise);
  }

  .status {
    display: flex;
    align-items: center;
    margin-left: auto;
    padding: 0 20px;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.04em;
    color: var(--text-3);
    border-left: 1px solid var(--line-soft);
    white-space: nowrap;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 20px 0 16px;
    border-left: 1px solid var(--line-soft);
  }

  .nav + .actions {
    margin-left: auto;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
  }

  .icon-btn:hover {
    color: var(--text);
    border-color: var(--text-3);
  }

  .sun {
    display: none;
  }

  :global([data-theme="light"]) .sun {
    display: block;
  }

  :global([data-theme="light"]) .moon {
    display: none;
  }

  @media (max-width: 1100px) {
    .status {
      display: none;
    }

    .actions {
      margin-left: auto;
    }
  }

  @media (max-width: 820px) {
    .nav {
      display: none;
    }

    .brand {
      border-right: 0;
      padding-left: 0;
    }

    .actions {
      border-left: 0;
      padding-right: 0;
    }
  }

  @media (max-width: 480px) {
    .actions .btn {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  toggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      // Storage can be blocked, so the choice lasts only for this page view
    }
  });
</script>
