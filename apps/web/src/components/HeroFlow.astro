<canvas class="hero-flow" data-flow aria-hidden="true"></canvas>

<style>
  .hero-flow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(to bottom, #000 80%, transparent);
  }
</style>

<script>
  type Curve = [number, number, number, number, number, number, number, number];

  interface Packet {
    lane: "in" | "out";
    index: number;
    p: number;
    speed: number;
    wait: number;
  }

  const INPUT = 46;
  const OUTPUT = 26;
  const PACKETS = 10;

  function point(c: Curve, t: number): [number, number] {
    const u = 1 - t;
    const a = u * u * u;
    const b = 3 * u * u * t;
    const d = 3 * u * t * t;
    const e = t * t * t;
    return [a * c[0] + b * c[2] + d * c[4] + e * c[6], a * c[1] + b * c[3] + d * c[5] + e * c[7]];
  }

  function rgba(color: string, alpha: number): string {
    const value = parseInt(color.replace("#", ""), 16);
    return `rgba(${(value >> 16) & 255}, ${(value >> 8) & 255}, ${value & 255}, ${alpha})`;
  }

  function start(canvas: HTMLCanvasElement) {
    const context = canvas.getContext("2d");
    const host = canvas.closest<HTMLElement>("[data-flow-host]");
    if (!context || !host) return;
    const ctx = context;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    let width = 0;
    let height = 0;
    let target = { x: 0, y: 0 };
    let exit = { x: 0, y: 0 };
    let palette = readPalette();
    let visible = true;
    let last = performance.now();
    let clock = 0;

    function readPalette() {
      const style = getComputedStyle(document.documentElement);
      return {
        line: style.getPropertyValue("--flow-line").trim() || "#9a9282",
        accent: style.getPropertyValue("--accent").trim() || "#ee7a43",
        glow: style.getPropertyValue("--accent-2").trim() || "#f6b16c",
        light: document.documentElement.dataset.theme === "light",
      };
    }

    function measure() {
      const rect = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      const art = host!.querySelector("[data-flow-target]")?.getBoundingClientRect();
      if (art && art.width > 0) {
        target = { x: art.left - rect.left + art.width * 0.36, y: art.top - rect.top + art.height * 0.6 };
        exit = { x: art.left - rect.left + art.width * 0.5, y: art.top - rect.top + art.height * 0.16 };
      } else {
        target = { x: width * 0.66, y: height * 0.6 };
        exit = { x: width * 0.76, y: height * 0.3 };
      }
    }

    function inputCurve(index: number, time: number): Curve {
      const s = index / (INPUT - 1);
      const wave = Math.sin(time * 0.00042 + s * 4.2);
      const drift = Math.cos(time * 0.00036 + s * 2.8);
      const x0 = -80 + s * width * 0.46;
      const y0 = height + 40;
      const x3 = target.x;
      const y3 = target.y + (s - 0.5) * 18;
      const x1 = x0 + (x3 - x0) * 0.3 + wave * 26;
      const y1 = y0 - (y0 - y3) * 0.5 - s * 70;
      const x2 = x3 - 300 + s * 150 + drift * 22;
      const y2 = y3 + 120 - s * 220 + wave * 10;
      return [x0, y0, x1, y1, x2, y2, x3, y3];
    }

    function outputCurve(index: number, time: number): Curve {
      const s = index / (OUTPUT - 1);
      const wave = Math.sin(time * 0.0005 + s * 3.4);
      const x0 = exit.x;
      const y0 = exit.y + (s - 0.5) * 8;
      const x3 = width * 0.82 + s * width * 0.3;
      const y3 = -40;
      const x1 = x0 + 70 + s * 40;
      const y1 = y0 - 70 - s * 20 + wave * 10;
      const x2 = x3 - 150 - s * 60 + wave * 24;
      const y2 = y3 + 150 + s * 20;
      return [x0, y0, x1, y1, x2, y2, x3, y3];
    }

    const packets: Packet[] = Array.from({ length: PACKETS }, (_, k) => ({
      lane: k % 3 === 0 ? "out" : "in",
      index: Math.floor(Math.random() * INPUT),
      p: Math.random(),
      speed: 0.00012 + Math.random() * 0.0001,
      wait: 0,
    }));

    function curveFor(packet: Packet, time: number): Curve {
      return packet.lane === "in"
        ? inputCurve(packet.index % INPUT, time)
        : outputCurve(packet.index % OUTPUT, time);
    }

    function drawLines(time: number) {
      const light = palette.light;
      ctx.lineWidth = 1;

      const inbound = ctx.createLinearGradient(0, height, target.x, target.y);
      inbound.addColorStop(0, rgba(palette.line, 0));
      inbound.addColorStop(0.45, rgba(palette.line, light ? 0.3 : 0.2));
      inbound.addColorStop(1, rgba(palette.accent, light ? 0.6 : 0.7));
      ctx.strokeStyle = inbound;
      ctx.beginPath();
      for (let i = 0; i < INPUT; i += 1) {
        const c = inputCurve(i, time);
        ctx.moveTo(c[0], c[1]);
        ctx.bezierCurveTo(c[2], c[3], c[4], c[5], c[6], c[7]);
      }
      ctx.stroke();

      const outbound = ctx.createLinearGradient(exit.x, exit.y, width, 0);
      outbound.addColorStop(0, rgba(palette.accent, light ? 0.55 : 0.6));
      outbound.addColorStop(0.6, rgba(palette.line, light ? 0.22 : 0.16));
      outbound.addColorStop(1, rgba(palette.line, 0));
      ctx.strokeStyle = outbound;
      ctx.beginPath();
      for (let i = 0; i < OUTPUT; i += 1) {
        const c = outputCurve(i, time);
        ctx.moveTo(c[0], c[1]);
        ctx.bezierCurveTo(c[2], c[3], c[4], c[5], c[6], c[7]);
      }
      ctx.stroke();
    }

    function drawPacket(packet: Packet, time: number) {
      if (packet.wait > 0) return;
      const curve = curveFor(packet, time);
      const length = packet.lane === "in" ? 0.14 : 0.2;
      const steps = 16;
      let previous = point(curve, Math.max(0, packet.p - length));
      ctx.lineCap = "round";
      for (let step = 1; step <= steps; step += 1) {
        const t = Math.max(0, packet.p - length + (length * step) / steps);
        const next = point(curve, Math.min(1, t));
        const strength = step / steps;
        ctx.strokeStyle = rgba(palette.glow, strength * strength * 0.95);
        ctx.lineWidth = 0.8 + strength * 1.1;
        ctx.beginPath();
        ctx.moveTo(previous[0], previous[1]);
        ctx.lineTo(next[0], next[1]);
        ctx.stroke();
        previous = next;
      }
    }

    function advance(delta: number) {
      for (const packet of packets) {
        if (packet.wait > 0) {
          packet.wait -= delta;
          continue;
        }
        packet.p += packet.speed * delta;
        if (packet.p < 1) continue;
        // Pulses that reach the blocks continue out along the upper bundle
        if (packet.lane === "in") {
          packet.lane = "out";
          packet.index = Math.floor(Math.random() * OUTPUT);
          packet.p = 0;
        } else {
          packet.lane = "in";
          packet.index = Math.floor(Math.random() * INPUT);
          packet.p = 0;
          packet.wait = 300 + Math.random() * 1800;
        }
      }
    }

    function draw(time: number, withPackets: boolean) {
      ctx.clearRect(0, 0, width, height);
      drawLines(time);
      if (withPackets) for (const packet of packets) drawPacket(packet, time);
    }

    function frame(now: number) {
      const delta = Math.min(now - last, 64);
      last = now;
      if (visible && !document.hidden && !reduced.matches) {
        clock += delta;
        advance(delta);
        draw(clock, true);
      }
      requestAnimationFrame(frame);
    }

    measure();
    draw(0, !reduced.matches);
    requestAnimationFrame(frame);

    new ResizeObserver(() => {
      measure();
      draw(clock, !reduced.matches);
    }).observe(host);

    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? true;
    }).observe(canvas);

    new MutationObserver(() => {
      palette = readPalette();
      draw(clock, !reduced.matches);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }

  document.querySelectorAll<HTMLCanvasElement>("[data-flow]").forEach(start);
</script>
