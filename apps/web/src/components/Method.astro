---
const steps = [
  {
    number: "01",
    title: "Read the code",
    text: "Every file is parsed and linked by its imports, then grouped into areas, so pages follow how the code is organized rather than how folders are named.",
  },
  {
    number: "02",
    title: "Write from sources",
    text: "Each paragraph is written from numbered excerpts of the code and has to name the excerpts it relies on.",
  },
  {
    number: "03",
    title: "Check every sentence",
    text: "Sentences without a source, names the cited code does not contain and snippets not copied from it are removed before a page goes live.",
  },
];
---

<div class="method">
  {
    steps.map((step, index) => (
      <div class="step" tabindex="0">
        <div class="art" aria-hidden="true">
          {index === 0 && (
            <svg viewBox="0 0 320 180">
              <g class="files">
                <rect x="20" y="26" width="92" height="14" rx="3" />
                <rect x="20" y="58" width="72" height="14" rx="3" />
                <rect x="20" y="90" width="100" height="14" rx="3" />
                <rect x="20" y="122" width="80" height="14" rx="3" />
              </g>
              <g class="draw">
                <path pathLength="1" d="M112 33 C 170 33 170 52 222 52" style="--n:0" />
                <path pathLength="1" d="M92 65 C 160 65 160 52 222 52" style="--n:1" />
                <path pathLength="1" d="M120 97 C 170 97 180 118 250 118" style="--n:2" />
                <path pathLength="1" d="M100 129 C 170 129 180 118 250 118" style="--n:3" />
                <path pathLength="1" d="M222 52 C 260 52 262 84 290 90" style="--n:5" />
                <path pathLength="1" d="M250 118 C 272 118 276 98 290 90" style="--n:6" />
              </g>
              <g class="appear">
                <circle class="node" cx="222" cy="52" r="6" style="--n:2" />
                <circle class="node" cx="250" cy="118" r="6" style="--n:4" />
                <circle class="node root" cx="290" cy="90" r="8" style="--n:7" />
              </g>
            </svg>
          )}
          {index === 1 && (
            <svg viewBox="0 0 320 180">
              <g class="sources">
                <rect x="20" y="20" width="54" height="24" rx="4" />
                <text x="47" y="36">
                  S1
                </text>
                <rect x="94" y="20" width="54" height="24" rx="4" />
                <text x="121" y="36">
                  S2
                </text>
                <rect x="168" y="20" width="54" height="24" rx="4" />
                <text x="195" y="36">
                  S3
                </text>
              </g>
              <g class="text-lines">
                <rect x="20" y="84" width="226" height="8" rx="4" />
                <rect x="20" y="108" width="196" height="8" rx="4" />
                <rect x="20" y="132" width="236" height="8" rx="4" />
              </g>
              <g class="draw">
                <path
                  pathLength="1"
                  d="M47 44 V 64 Q 47 72 55 72 H 256 Q 264 72 264 80 V 82"
                  style="--n:0"
                />
                <path pathLength="1" d="M121 44 V 100 Q 121 106 127 106 H 234" style="--n:2" />
                <path
                  pathLength="1"
                  d="M195 44 V 56 Q 195 62 201 62 H 290 Q 298 62 298 70 V 128"
                  style="--n:4"
                />
              </g>
              <g class="appear">
                <rect class="chip" x="254" y="80" width="20" height="16" rx="3" style="--n:3" />
                <rect class="chip" x="226" y="104" width="20" height="16" rx="3" style="--n:5" />
                <rect class="chip" x="288" y="128" width="20" height="16" rx="3" style="--n:7" />
              </g>
            </svg>
          )}
          {index === 2 && (
            <svg viewBox="0 0 320 180">
              <g class="rows">
                <rect x="20" y="30" width="210" height="8" rx="4" />
                <rect class="struck" x="20" y="66" width="236" height="8" rx="4" />
                <rect x="20" y="102" width="190" height="8" rx="4" />
                <rect x="20" y="138" width="222" height="8" rx="4" />
              </g>
              <g class="scan">
                <rect x="14" y="20" width="2" height="136" rx="1" />
              </g>
              <g class="draw">
                <path class="strike" pathLength="1" d="M14 70 H 262" style="--n:2" />
                <path class="tick" pathLength="1" d="M270 34 l6 6 l12 -12" style="--n:1" />
                <path class="tick" pathLength="1" d="M270 106 l6 6 l12 -12" style="--n:4" />
                <path class="tick" pathLength="1" d="M270 142 l6 6 l12 -12" style="--n:5" />
              </g>
              <g class="appear">
                <text class="removed" x="270" y="74" style="--n:3">
                  no source
                </text>
              </g>
            </svg>
          )}
        </div>
        <span class="number mono">{step.number}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </div>
    ))
  }
</div>

<style>
  .method {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line-soft);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 28px 36px;
    outline: none;
    transition: background-color 200ms ease;
  }

  .step:hover,
  .step:focus-visible {
    background: var(--bg-raise);
  }

  .step + .step {
    border-left: 1px solid var(--line-soft);
  }

  .art {
    height: 180px;
    margin: -4px -4px 18px;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    background:
      linear-gradient(var(--line-soft) 1px, transparent 1px) 0 0 / 20px 20px,
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px) 0 0 / 20px 20px,
      var(--bg-raise);
    overflow: hidden;
  }

  .art svg {
    width: 100%;
    height: 100%;
  }

  .number {
    font-size: var(--t-caption);
    color: var(--accent);
  }

  h3 {
    font-size: var(--t-h3);
    line-height: 1.25;
  }

  p {
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--text-2);
  }

  .files rect,
  .sources rect,
  .rows rect,
  .text-lines rect {
    fill: var(--panel-2);
    stroke: var(--line);
  }

  .sources text,
  .removed {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-2);
    text-anchor: middle;
  }

  .removed {
    text-anchor: start;
    fill: var(--accent);
  }

  /* The resting state is the finished diagram */
  .draw path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.3;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .draw .tick {
    stroke: var(--accent-2);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .node {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 1.3;
  }

  .node.root,
  .chip {
    fill: var(--accent);
  }

  .struck {
    opacity: 0.3;
  }

  .scan rect {
    fill: var(--accent-2);
    opacity: 0;
  }

  /* Hovering a step plays how it happens, once, ending on the finished diagram */
  @media (hover: hover) {
    .step:hover .draw path,
    .step:focus-visible .draw path {
      animation: draw 620ms var(--ease) both;
      animation-delay: calc(var(--n) * 130ms);
    }

    .step:hover .appear > *,
    .step:focus-visible .appear > * {
      animation: appear 260ms ease both;
      animation-delay: calc(var(--n) * 130ms + 200ms);
    }

    .step:hover .struck,
    .step:focus-visible .struck {
      animation: dim 400ms ease both;
      animation-delay: 560ms;
    }

    .step:hover .scan rect,
    .step:focus-visible .scan rect {
      animation: scan 1100ms var(--ease) both;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes dim {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.3;
    }
  }

  @keyframes scan {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    10% {
      opacity: 0.9;
    }
    90% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translateX(250px);
    }
  }

  @media (max-width: 900px) {
    .method {
      grid-template-columns: 1fr;
    }

    .step + .step {
      border-left: 0;
      border-top: 1px solid var(--line-soft);
    }
  }
</style>
