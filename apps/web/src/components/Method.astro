---
const steps = [
  {
    number: "01",
    title: "Read the code",
    text: "Every file is parsed and linked by its imports, then grouped into areas, so pages follow how the code is organized rather than how folders are named.",
  },
  {
    number: "02",
    title: "Write from sources",
    text: "Each paragraph is written from numbered excerpts of the code and has to name the excerpts it relies on.",
  },
  {
    number: "03",
    title: "Check every sentence",
    text: "Sentences without a source, names the cited code does not contain and snippets not copied from it are removed before a page goes live.",
  },
];

const readEdges = [
  { d: "M112 33 C 170 33 170 52 222 52", delay: 0 },
  { d: "M92 65 C 160 65 160 52 222 52", delay: 140 },
  { d: "M120 97 C 170 97 180 118 250 118", delay: 280 },
  { d: "M100 129 C 170 129 180 118 250 118", delay: 420 },
  { d: "M222 52 C 260 52 262 84 290 90", delay: 900 },
  { d: "M250 118 C 272 118 276 98 290 90", delay: 1180 },
];

const writeLinks = [
  { d: "M47 44 V 64 Q 47 72 55 72 H 256 Q 264 72 264 80 V 82", delay: 0 },
  { d: "M121 44 V 100 Q 121 106 127 106 H 234", delay: 520 },
  { d: "M195 44 V 56 Q 195 62 201 62 H 290 Q 298 62 298 70 V 128", delay: 1040 },
];
---

<div class="method">
  {
    steps.map((step, index) => (
      <div class="step" tabindex="0">
        <div class="art" aria-hidden="true">
          {index === 0 && (
            <svg viewBox="0 0 320 180">
              <g class="rows">
                <rect class="file" x="20" y="26" width="92" height="14" rx="3" style="--d:0ms" />
                <rect class="file" x="20" y="58" width="72" height="14" rx="3" style="--d:140ms" />
                <rect class="file" x="20" y="90" width="100" height="14" rx="3" style="--d:280ms" />
                <rect class="file" x="20" y="122" width="80" height="14" rx="3" style="--d:420ms" />
              </g>
              <g class="lines">
                {readEdges.map((edge) => (
                  <path d={edge.d} />
                ))}
              </g>
              <g class="signals">
                {readEdges.map((edge, n) => (
                  <path
                    pathLength="1"
                    d={edge.d}
                    style={`--d:${edge.delay}ms;--t:${n < 4 ? 700 : 600}ms`}
                  />
                ))}
              </g>
              <circle class="node" cx="222" cy="52" r="6" style="--d:760ms" />
              <circle class="node" cx="250" cy="118" r="6" style="--d:1040ms" />
              <circle class="node root" cx="290" cy="90" r="8" style="--d:1640ms" />
            </svg>
          )}
          {index === 1 && (
            <svg viewBox="0 0 320 180">
              <g class="sources">
                <rect class="src" x="20" y="20" width="54" height="24" rx="4" style="--d:0ms" />
                <text x="47" y="36">
                  S1
                </text>
                <rect class="src" x="94" y="20" width="54" height="24" rx="4" style="--d:520ms" />
                <text x="121" y="36">
                  S2
                </text>
                <rect class="src" x="168" y="20" width="54" height="24" rx="4" style="--d:1040ms" />
                <text x="195" y="36">
                  S3
                </text>
              </g>
              <g class="rows">
                <rect x="20" y="84" width="226" height="8" rx="4" />
                <rect x="20" y="108" width="196" height="8" rx="4" />
                <rect x="20" y="132" width="236" height="8" rx="4" />
              </g>
              <g class="sweeps">
                <path pathLength="1" d="M24 88 H 242" style="--d:560ms" />
                <path pathLength="1" d="M24 112 H 212" style="--d:1080ms" />
                <path pathLength="1" d="M24 136 H 252" style="--d:1600ms" />
              </g>
              <g class="lines">
                {writeLinks.map((link) => (
                  <path d={link.d} />
                ))}
              </g>
              <g class="signals">
                {writeLinks.map((link) => (
                  <path pathLength="1" d={link.d} style={`--d:${link.delay}ms;--t:560ms`} />
                ))}
              </g>
              <rect class="chip" x="254" y="80" width="20" height="16" rx="3" style="--d:500ms" />
              <rect class="chip" x="226" y="104" width="20" height="16" rx="3" style="--d:1020ms" />
              <rect class="chip" x="288" y="128" width="20" height="16" rx="3" style="--d:1540ms" />
            </svg>
          )}
          {index === 2 && (
            <svg viewBox="0 0 320 180">
              <g class="rows">
                <rect x="20" y="30" width="210" height="8" rx="4" />
                <rect class="struck" x="20" y="66" width="236" height="8" rx="4" />
                <rect x="20" y="102" width="190" height="8" rx="4" />
                <rect x="20" y="138" width="222" height="8" rx="4" />
              </g>
              <g class="sweeps">
                <path pathLength="1" d="M24 34 H 226" style="--d:0ms" />
                <path pathLength="1" d="M24 70 H 252" style="--d:380ms" />
                <path pathLength="1" d="M24 106 H 206" style="--d:760ms" />
                <path pathLength="1" d="M24 142 H 238" style="--d:1140ms" />
              </g>
              <path class="strike" d="M14 70 H 262" style="--d:760ms" />
              <path class="tick" d="M270 34 l6 6 l12 -12" style="--d:380ms" />
              <path class="tick" d="M270 106 l6 6 l12 -12" style="--d:1140ms" />
              <path class="tick" d="M270 142 l6 6 l12 -12" style="--d:1520ms" />
              <text class="removed" x="270" y="74" style="--d:760ms">
                no source
              </text>
            </svg>
          )}
        </div>
        <span class="number mono">{step.number}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </div>
    ))
  }
</div>

<style>
  .method {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line-soft);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 28px 36px;
    outline: none;
    transition: background-color 200ms ease;
  }

  .step:hover,
  .step:focus-visible {
    background: var(--bg-raise);
  }

  .step + .step {
    border-left: 1px solid var(--line-soft);
  }

  .art {
    height: 180px;
    margin: -4px -4px 18px;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    background:
      linear-gradient(var(--line-soft) 1px, transparent 1px) 0 0 / 20px 20px,
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px) 0 0 / 20px 20px,
      var(--bg-raise);
    overflow: hidden;
  }

  .art svg {
    width: 100%;
    height: 100%;
  }

  .number {
    font-size: var(--t-caption);
    color: var(--accent);
  }

  h3 {
    font-size: var(--t-h3);
    line-height: 1.25;
  }

  p {
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--text-2);
  }

  /* Resting state: the finished diagram */
  .rows rect,
  .sources rect {
    fill: var(--panel-2);
    stroke: var(--line);
  }

  .sources text,
  .removed {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-2);
    text-anchor: middle;
  }

  .removed {
    text-anchor: start;
    fill: var(--accent);
  }

  .lines path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.3;
  }

  .node {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 1.3;
  }

  .node.root,
  .chip {
    fill: var(--accent);
  }

  .strike {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
  }

  .tick {
    fill: none;
    stroke: var(--accent-2);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .struck {
    opacity: 0.3;
  }

  .signals path {
    fill: none;
    stroke: var(--accent-2);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-dasharray: 0.12 2;
    stroke-dashoffset: 0.12;
    opacity: 0;
  }

  .sweeps path {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: 0.3;
    stroke-width: 14;
    stroke-linecap: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  /* Hovering runs the step on the finished diagram: signals follow the lines and the parts they reach respond */
  @media (hover: hover) {
    .step:hover .signals path,
    .step:focus-visible .signals path {
      animation: travel var(--t) var(--ease) var(--d) both;
    }

    .step:hover .file,
    .step:focus-visible .file {
      animation: read-file 560ms ease var(--d) both;
    }

    .step:hover .node,
    .step:focus-visible .node {
      animation: reach-node 480ms ease var(--d) both;
    }

    .step:hover .node.root,
    .step:focus-visible .node.root {
      animation-name: reach-root;
    }

    .step:hover .src,
    .step:focus-visible .src {
      animation: use-source 620ms ease var(--d) both;
    }

    .step:hover .chip,
    .step:focus-visible .chip {
      animation: reach-chip 480ms ease var(--d) both;
    }

    .step:hover .sweeps path,
    .step:focus-visible .sweeps path {
      animation: sweep 720ms var(--ease-out) var(--d) both;
    }

    .step:hover .tick,
    .step:focus-visible .tick {
      animation: confirm 520ms ease var(--d) both;
    }

    .step:hover .strike,
    .step:focus-visible .strike {
      animation: flag 620ms ease var(--d) both;
    }

    .step:hover .removed,
    .step:focus-visible .removed {
      animation: flag-label 620ms ease var(--d) both;
    }
  }

  @keyframes travel {
    0% {
      stroke-dashoffset: 0.12;
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -1;
      opacity: 0;
    }
  }

  @keyframes read-file {
    0%,
    100% {
      fill: var(--panel-2);
      stroke: var(--line);
    }
    35% {
      fill: var(--accent-soft);
      stroke: var(--accent);
    }
  }

  @keyframes reach-node {
    0%,
    100% {
      fill: var(--bg);
    }
    40% {
      fill: var(--accent-2);
    }
  }

  @keyframes reach-root {
    0%,
    100% {
      fill: var(--accent);
    }
    40% {
      fill: var(--text);
    }
  }

  @keyframes use-source {
    0%,
    100% {
      stroke: var(--line);
      fill: var(--panel-2);
    }
    30% {
      stroke: var(--accent);
      fill: var(--accent-soft);
    }
  }

  @keyframes reach-chip {
    0%,
    100% {
      fill: var(--accent);
    }
    40% {
      fill: var(--accent-2);
    }
  }

  @keyframes sweep {
    0% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    55% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  @keyframes confirm {
    0%,
    100% {
      stroke: var(--accent-2);
    }
    40% {
      stroke: var(--text);
    }
  }

  @keyframes flag {
    0%,
    100% {
      stroke: var(--accent);
    }
    40% {
      stroke: var(--accent-2);
    }
  }

  @keyframes flag-label {
    0%,
    100% {
      fill: var(--accent);
    }
    40% {
      fill: var(--accent-2);
    }
  }

  @media (max-width: 900px) {
    .method {
      grid-template-columns: 1fr;
    }

    .step + .step {
      border-left: 0;
      border-top: 1px solid var(--line-soft);
    }
  }
</style>
