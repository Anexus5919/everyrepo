---
import RepoOpener from "./RepoOpener.astro";
---

<dialog class="repo-dialog" aria-labelledby="repo-dialog-title" data-repo-dialog>
  <div class="shell">
    <header class="head">
      <div>
        <h2 id="repo-dialog-title">Open a repository</h2>
        <p>
          Paste a GitHub link or type owner/name. Written wikis open right away, and any other public
          repository can be requested.
        </p>
      </div>
      <button class="close" type="button" aria-label="Close" data-repo-dialog-close>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
          ><path d="M4 4l8 8M12 4l-8 8"></path></svg
        >
      </button>
    </header>
    <RepoOpener id="dialog-opener" variant="dialog" />
    <footer class="foot">
      <span>Small repositories are approved automatically; large ones are approved by hand.</span>
      <a href="/queue/">See the queue</a>
    </footer>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-repo-dialog]");
  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>("input")!;

    const open = () => {
      document.querySelectorAll<HTMLDialogElement>("dialog[open]").forEach((other) => {
        if (other !== dialog) other.close();
      });
      if (!dialog.open) dialog.showModal();
      document.documentElement.classList.add("has-modal");
      input.focus();
      input.select();
    };

    // Buttons and links marked data-open-repo open this window; without scripts their links still lead to the home page form
    document.addEventListener("click", (event) => {
      const trigger = (event.target as HTMLElement).closest("[data-open-repo]");
      if (!trigger) return;
      event.preventDefault();
      open();
    });

    dialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.closest("[data-repo-dialog-close]")) dialog.close();
    });
    dialog.addEventListener("close", () => document.documentElement.classList.remove("has-modal"));
  }
</script>

<style>
  .repo-dialog {
    width: min(620px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100svh - 32px);
    margin: max(12vh, 16px) auto auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raise);
    color: var(--text);
    box-shadow: var(--shadow);
    overflow: visible;
  }

  .repo-dialog::backdrop {
    background: rgba(8, 7, 6, 0.55);
    backdrop-filter: blur(3px);
  }

  .repo-dialog[open] {
    animation: dialog-open 220ms var(--ease-out);
  }

  @keyframes dialog-open {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .shell {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 22px 22px 18px;
  }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  h2 {
    font-size: var(--t-h3);
    line-height: 1.2;
  }

  .head p {
    margin-top: 6px;
    font-size: var(--t-caption);
    line-height: 1.6;
    color: var(--text-2);
  }

  .close {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
  }

  .close:hover {
    border-color: var(--line);
    color: var(--text);
  }

  .close svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .foot a {
    color: var(--text);
    border-bottom: 1px solid var(--line);
  }

  .foot a:hover {
    border-color: var(--text-3);
  }

  :global(html.has-modal) {
    overflow: hidden;
  }
</style>
