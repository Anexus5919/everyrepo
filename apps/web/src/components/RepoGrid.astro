---
import type { SiteRepo } from "@everyrepo/core";
import BookIcon from "./BookIcon.astro";
import { formatCount, languageName } from "../lib/format.ts";

interface Props {
  repos: SiteRepo[];
  outlines: Record<string, string[]>;
}
const { repos, outlines } = Astro.props;

const SHADES = ["var(--accent)", "var(--accent-2)", "var(--text-3)", "var(--line)"];
const PEEK = 3;

const cards = repos.map((repo) => {
  const total = repo.languages.reduce((sum, language) => sum + language.files, 0) || 1;
  const top = repo.languages.slice(0, 3);
  const rest = total - top.reduce((sum, language) => sum + language.files, 0);
  const segments = [
    ...top.map((language) => ({
      name: languageName(language.language),
      share: language.files / total,
    })),
    ...(rest > 0 ? [{ name: "Other", share: rest / total }] : []),
  ].map((segment, index) => ({ ...segment, color: SHADES[index] ?? "var(--line)" }));
  const outline = outlines[repo.repo] ?? [];
  return { ...repo, segments, outline };
});

const order = { ready: 0, indexing: 1, queued: 2 } as const;
cards.sort((a, b) => order[a.status] - order[b.status]);
---

<div class="repo-grid">
  {
    cards.map((repo) =>
      repo.status === "ready" ? (
        <a class="repo book-trigger" href={`/${repo.repo}`}>
          <span class="owner mono">{repo.owner}</span>
          <span class="name">{repo.name}</span>
          <div class="swap">
            <p class="summary">{repo.summary}</p>
            <div class="outline" aria-hidden="true">
              <span class="outline-label">Sections</span>
              <ul>
                {repo.outline.slice(0, PEEK).map((title) => (
                  <li>{title}</li>
                ))}
              </ul>
              {repo.outline.length > PEEK && (
                <span class="outline-more">and {repo.outline.length - PEEK} more</span>
              )}
            </div>
          </div>
          <span class="bar" aria-hidden="true">
            {repo.segments.map((segment) => (
              <span style={`flex-grow:${segment.share};background:${segment.color}`} />
            ))}
          </span>
          <span class="languages">
            {repo.segments
              .filter((segment) => segment.name !== "Other" && segment.share >= 0.01)
              .map((segment) => `${segment.name} ${Math.round(segment.share * 100)}%`)
              .join("  ")}
          </span>
          <span class="stats">
            <span>{repo.pages} pages</span>
            <span>{formatCount(repo.files)} files</span>
            <span class="go">
              <BookIcon />
            </span>
          </span>
        </a>
      ) : (
        <div class="repo is-waiting">
          <span class="owner mono">{repo.owner}</span>
          <span class="name">{repo.name}</span>
          <span class="state">
            <span class="dot" />
            {repo.status === "indexing" ? "Reading the code" : "Queued for writing"}
          </span>
          <span class="languages">
            {repo.segments
              .filter((segment) => segment.name !== "Other")
              .slice(0, 2)
              .map((segment) => segment.name)
              .join(", ")}
          </span>
          <span class="stats">
            <span>{formatCount(repo.files)} files</span>
            <span>{repo.packages} packages</span>
          </span>
        </div>
      ),
    )
  }
  <a class="repo is-cta book-trigger" href="/#open" data-open-repo>
    <span class="owner mono">your/repository</span>
    <span class="name">Missing one?</span>
    <p class="summary">Paste any public GitHub link to request its wiki and follow it being written.</p>
    <span class="stats">
      <span>Open a repository</span>
      <span class="go">
        <BookIcon />
      </span>
    </span>
  </a>
</div>

<style>
  .repo-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-soft);
    border-block: 1px solid var(--line-soft);
  }

  .repo {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: clamp(220px, calc((100svh - var(--header) - 380px) / 2), 300px);
    padding: 20px 24px 18px;
    background: var(--bg);
    transition: background-color 200ms ease;
  }

  a.repo:hover,
  a.repo:focus-visible {
    background: var(--bg-raise);
  }

  .owner {
    font-size: var(--t-label);
    color: var(--text-3);
  }

  .name {
    margin-top: -6px;
    font-family: var(--font-serif);
    font-size: var(--t-h3);
    line-height: 1.25;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .swap {
    display: grid;
  }

  .swap > * {
    grid-area: 1 / 1;
    align-self: start;
    transition: opacity 220ms ease;
  }

  .summary {
    font-size: var(--t-small);
    line-height: 1.55;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .outline {
    opacity: 0;
    font-size: var(--t-caption);
    color: var(--text-2);
  }

  .outline-label {
    font-size: var(--t-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .outline ul {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .outline li {
    padding: 1px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .outline-more {
    color: var(--text-3);
  }

  /* Hovering a written wiki shows what is inside it instead of its summary */
  a.repo:hover .summary,
  a.repo:focus-visible .summary {
    opacity: 0;
  }

  a.repo:hover .outline,
  a.repo:focus-visible .outline {
    opacity: 1;
  }

  .bar {
    display: flex;
    gap: 2px;
    height: 4px;
    margin-top: auto;
    border-radius: 2px;
    overflow: hidden;
  }

  .languages {
    font-size: var(--t-label);
    color: var(--text-3);
    white-space: pre-wrap;
  }

  .stats {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--line-soft);
    font-size: var(--t-caption);
    color: var(--text-2);
  }

  .go {
    display: flex;
    margin-left: auto;
    color: var(--text-3);
    transition: color 160ms ease;
  }

  a.repo:hover .go {
    color: var(--accent);
  }

  .is-waiting .name {
    color: var(--text-2);
  }

  .is-waiting .languages {
    margin-top: auto;
  }

  .state {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--t-ui);
    color: var(--text-2);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }

  .is-cta {
    background:
      repeating-linear-gradient(-45deg, transparent 0 9px, var(--line-soft) 9px 10px), var(--bg);
  }

  .is-cta .summary {
    margin-bottom: auto;
  }

  .is-cta .stats span:first-child {
    color: var(--text);
    font-weight: 500;
  }

  /* Short screens drop the language line and shorten summaries so both rows fit on one screen */
  @media (max-height: 860px) and (min-width: 1000px) {
    .languages {
      display: none;
    }

    .repo {
      min-height: 0;
    }

    .summary {
      -webkit-line-clamp: 2;
      max-height: calc(1.55em * 2);
    }

    .outline li:nth-child(n + 3) {
      display: none;
    }
  }

  @media (max-width: 1100px) {
    .repo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .repo-grid {
      grid-template-columns: 1fr;
    }

    .repo {
      min-height: 0;
    }
  }
</style>
