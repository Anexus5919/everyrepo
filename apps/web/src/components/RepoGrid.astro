---
import type { SiteRepo } from "@everyrepo/core";
import Arrow from "./Arrow.astro";
import { formatCount, languageName } from "../lib/format.ts";

interface Props {
  repos: SiteRepo[];
}
const { repos } = Astro.props;

const SHADES = ["var(--accent)", "var(--accent-2)", "var(--text-3)", "var(--line)"];

const cards = repos.map((repo) => {
  const total = repo.languages.reduce((sum, language) => sum + language.files, 0) || 1;
  const top = repo.languages.slice(0, 3);
  const rest = total - top.reduce((sum, language) => sum + language.files, 0);
  const segments = [
    ...top.map((language) => ({ name: languageName(language.language), share: language.files / total })),
    ...(rest > 0 ? [{ name: "Other", share: rest / total }] : []),
  ].map((segment, index) => ({ ...segment, color: SHADES[index] ?? "var(--line)" }));
  return { ...repo, segments };
});

const order = { ready: 0, indexing: 1, queued: 2 } as const;
cards.sort((a, b) => order[a.status] - order[b.status]);
---

<div class="repo-grid">
  {
    cards.map((repo) =>
      repo.status === "ready" ? (
        <a class="repo" href={`/${repo.repo}`}>
          <span class="owner mono">{repo.owner}</span>
          <span class="name">{repo.name}</span>
          <p class="summary">{repo.summary}</p>
          <span class="bar" aria-hidden="true">
            {repo.segments.map((segment) => (
              <span style={`flex-grow:${segment.share};background:${segment.color}`} />
            ))}
          </span>
          <span class="languages">
            {repo.segments
              .filter((segment) => segment.name !== "Other")
              .map((segment) => `${segment.name} ${Math.round(segment.share * 100)}%`)
              .join("  ")}
          </span>
          <span class="stats">
            <span>{repo.pages} pages</span>
            <span>{formatCount(repo.files)} files</span>
            <span class="go">
              <Arrow />
            </span>
          </span>
        </a>
      ) : (
        <div class="repo is-waiting">
          <span class="owner mono">{repo.owner}</span>
          <span class="name">{repo.name}</span>
          <span class="state">
            <span class="pulse" />
            {repo.status === "indexing" ? "Reading the code" : "Queued for writing"}
          </span>
          <span class="progress" aria-hidden="true" />
          <span class="languages">
            {repo.segments
              .filter((segment) => segment.name !== "Other")
              .slice(0, 2)
              .map((segment) => segment.name)
              .join(", ")}
          </span>
          <span class="stats">
            <span>{formatCount(repo.files)} files</span>
            <span>{repo.packages} packages</span>
          </span>
        </div>
      ),
    )
  }
  <a class="repo is-cta" href="#open">
    <span class="owner mono">your/repository</span>
    <span class="name">Missing one?</span>
    <p class="summary">Paste a public GitHub link and its wiki joins the queue.</p>
    <span class="stats">
      <span>Open a repository</span>
      <span class="go">
        <Arrow />
      </span>
    </span>
  </a>
</div>

<style>
  .repo-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-soft);
    border-block: 1px solid var(--line-soft);
  }

  .repo {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 300px;
    padding: 26px 24px 22px;
    background: var(--bg);
    transition: background-color 180ms ease;
  }

  a.repo:hover {
    background: var(--bg-raise);
  }

  a.repo::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 2px;
    background: var(--accent);
    transition: width 320ms var(--ease-out);
  }

  a.repo:hover::before {
    width: 100%;
  }

  .owner {
    font-size: var(--t-label);
    color: var(--text-3);
  }

  .name {
    margin-top: -6px;
    font-family: var(--font-serif);
    font-size: var(--t-h3);
    line-height: 1.25;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .summary {
    font-size: var(--t-small);
    line-height: 1.55;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bar {
    display: flex;
    gap: 2px;
    height: 4px;
    margin-top: auto;
    border-radius: 2px;
    overflow: hidden;
  }

  .languages {
    font-size: var(--t-label);
    color: var(--text-3);
    white-space: pre-wrap;
  }

  .stats {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
    font-size: var(--t-caption);
    color: var(--text-2);
  }

  .go {
    margin-left: auto;
    color: var(--text-3);
    transition:
      transform 240ms var(--ease-out),
      color 160ms ease;
  }

  a.repo:hover .go {
    color: var(--accent);
    transform: translateX(4px);
  }

  .is-waiting .name {
    color: var(--text-2);
  }

  .state {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--t-ui);
    color: var(--text-2);
  }

  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-line);
    animation: pulse 2.2s ease-out infinite;
  }

  .progress {
    position: relative;
    height: 1px;
    margin-top: auto;
    background: var(--line);
    overflow: hidden;
  }

  .progress::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 30%;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: sweep 2.8s var(--ease) infinite;
  }

  .is-cta {
    background:
      repeating-linear-gradient(-45deg, transparent 0 9px, var(--line-soft) 9px 10px),
      var(--bg);
  }

  .is-cta .summary {
    margin-bottom: auto;
  }

  .is-cta .stats span:first-child {
    color: var(--text);
    font-weight: 500;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 var(--accent-line);
    }
    70%,
    100% {
      box-shadow: 0 0 0 8px transparent;
    }
  }

  @keyframes sweep {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(340%);
    }
  }

  @media (max-width: 1100px) {
    .repo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .repo-grid {
      grid-template-columns: 1fr;
    }

    .repo {
      min-height: 0;
    }
  }
</style>
