<canvas class="ribbon" data-ribbon aria-hidden="true"></canvas>

<style>
  .ribbon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 90px), transparent calc(100% - 60px));
  }
</style>

<script>
  // The band is laid out in a fixed design space and scaled to cover the canvas
  const DESIGN_W = 1920;
  const DESIGN_H = 900;
  const STRANDS = 26;
  const SAMPLES = 120;
  const GAP = 5;
  const AMPLITUDE = 180;
  const BULGE = 0.7;
  const CYCLES = 0.75;
  const PHASE_STEP = 0.14;
  const COUNTER = 0.42;
  const ANGLE = (-33 * Math.PI) / 180;
  const LENGTH = 2400;
  const CENTER_X = 1240;
  const CENTER_Y = 500;
  const STREAKS = 6;
  const STREAK_LENGTH = 90;

  interface Palette {
    from: [number, number, number];
    to: [number, number, number];
    streak: string[];
    alpha: number;
  }

  const hexToRgb = (hex: string): [number, number, number] => {
    const value = parseInt(hex.trim().replace("#", ""), 16);
    return [(value >> 16) & 255, (value >> 8) & 255, value & 255];
  };

  function start(canvas: HTMLCanvasElement) {
    const context = canvas.getContext("2d");
    if (!context) return;
    const ctx = context;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let width = 0;
    let height = 0;
    let ratio = 1;
    let visible = false;
    let clock = 0;
    let last = performance.now();
    let palette = read();
    const strands: Array<Array<[number, number]>> = Array.from({ length: STRANDS }, () =>
      Array.from({ length: SAMPLES + 1 }, () => [0, 0] as [number, number]),
    );
    const lengths = new Float32Array(STRANDS);

    function read(): Palette {
      const light = document.documentElement.dataset.theme === "light";
      return light
        ? { from: hexToRgb("#b8532f"), to: hexToRgb("#d9823f"), streak: ["#b8532f", "#d9823f", "#1c1a16"], alpha: 0.75 }
        : { from: hexToRgb("#e8692f"), to: hexToRgb("#f7c47e"), streak: ["#ee7a43", "#f6b16c", "#fff4e6"], alpha: 0.85 };
    }

    function fit() {
      const rect = canvas.getBoundingClientRect();
      ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
    }

    // Each strand is a sine wave whose phase is shifted from its neighbours, so strands weave across each other
    function build(time: number) {
      const scale = Math.max(width / DESIGN_W, height / DESIGN_H);
      const offsetX = (width - DESIGN_W * scale) / 2;
      const offsetY = (height - DESIGN_H * scale) / 2;
      const cos = Math.cos(ANGLE);
      const sin = Math.sin(ANGLE);
      const wave = 2 * Math.PI * CYCLES;
      for (let k = 0; k < STRANDS; k += 1) {
        const index = k - (STRANDS - 1) / 2;
        const points = strands[k]!;
        let total = 0;
        let previousX = 0;
        let previousY = 0;
        for (let j = 0; j <= SAMPLES; j += 1) {
          const s = j / SAMPLES;
          const envelope = 1 + BULGE * Math.sin(Math.PI * s);
          const primary = Math.sin(wave * s + PHASE_STEP * index + time * 0.12);
          const counter = Math.sin(0.5 * wave * s - 2 * PHASE_STEP * index + time * 0.45);
          const y = index * GAP + (primary + COUNTER * counter) * 0.5 * envelope * AMPLITUDE;
          const x = (s - 0.5) * LENGTH;
          const point = points[j]!;
          const px = offsetX + (CENTER_X + x * cos - y * sin) * scale;
          const py = offsetY + (CENTER_Y + x * sin + y * cos) * scale;
          if (j > 0) total += Math.hypot(px - previousX, py - previousY);
          previousX = px;
          previousY = py;
          point[0] = px;
          point[1] = py;
        }
        lengths[k] = total;
      }
    }

    function at(points: Array<[number, number]>, s: number): [number, number] {
      const position = Math.max(0, Math.min(1, s)) * SAMPLES;
      const index = Math.min(SAMPLES - 1, Math.floor(position));
      const t = position - index;
      const a = points[index]!;
      const b = points[index + 1]!;
      return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
    }

    function draw(time: number) {
      build(time);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, width, height);
      ctx.lineWidth = 1;
      ctx.lineJoin = "round";
      ctx.lineCap = "round";
      for (let k = 0; k < STRANDS; k += 1) {
        const points = strands[k]!;
        const mix = k / (STRANDS - 1);
        const rgb = palette.from.map((value, channel) => Math.round(value + (palette.to[channel]! - value) * mix));
        const color = `${rgb[0]}, ${rgb[1]}, ${rgb[2]}`;
        const first = points[0]!;
        const end = points[SAMPLES]!;
        const gradient = ctx.createLinearGradient(first[0], first[1], end[0], end[1]);
        gradient.addColorStop(0, `rgba(${color}, 0)`);
        gradient.addColorStop(0.3, `rgba(${color}, ${palette.alpha})`);
        gradient.addColorStop(1, `rgba(${color}, ${palette.alpha})`);
        ctx.strokeStyle = gradient;
        ctx.beginPath();
        ctx.moveTo(first[0], first[1]);
        for (let j = 1; j < SAMPLES; j += 1) {
          const a = points[j]!;
          const b = points[j + 1]!;
          ctx.quadraticCurveTo(a[0], a[1], (a[0] + b[0]) / 2, (a[1] + b[1]) / 2);
        }
        ctx.lineTo(end[0], end[1]);
        ctx.stroke();
      }

      if (reduced.matches) return;
      // Short streaks of light travel along the strands toward the upper right
      for (let n = 0; n < STREAKS; n += 1) {
        const strand = (n * 7 + 3) % STRANDS;
        const cycle = 4.2 + (n % 3) * 0.7;
        const progress = ((time + n * 1.37) % (cycle + 1.6)) / cycle;
        if (progress > 1) continue;
        const points = strands[strand]!;
        const span = STREAK_LENGTH / Math.max(1, lengths[strand]!);
        const fade = progress < 0.2 ? progress / 0.2 : progress > 0.75 ? (1 - progress) / 0.25 : 1;
        const head = at(points, progress);
        const tail = at(points, progress - span);
        const color = hexToRgb(palette.streak[n % palette.streak.length]!);
        const gradient = ctx.createLinearGradient(tail[0], tail[1], head[0], head[1]);
        gradient.addColorStop(0, `rgba(${color.join(", ")}, 0)`);
        gradient.addColorStop(1, `rgba(${color.join(", ")}, ${0.95 * fade})`);
        ctx.strokeStyle = gradient;
        ctx.lineWidth = 2.4;
        ctx.beginPath();
        ctx.moveTo(tail[0], tail[1]);
        for (let step = 1; step <= 8; step += 1) {
          const point = at(points, progress - span + (span * step) / 8);
          ctx.lineTo(point[0], point[1]);
        }
        ctx.stroke();
      }
    }

    function frame(now: number) {
      const delta = Math.min(now - last, 64) / 1000;
      last = now;
      if (visible && !document.hidden && !reduced.matches) {
        clock += delta;
        draw(clock);
      }
      requestAnimationFrame(frame);
    }

    fit();
    draw(0);
    requestAnimationFrame(frame);
    new ResizeObserver(() => {
      fit();
      draw(clock);
    }).observe(canvas);
    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
    }).observe(canvas);
    new MutationObserver(() => {
      palette = read();
      draw(clock);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }

  document.querySelectorAll<HTMLCanvasElement>("[data-ribbon]").forEach(start);
</script>
