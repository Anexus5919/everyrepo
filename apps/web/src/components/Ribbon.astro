<canvas class="ribbon" data-ribbon></canvas>

<style>
  .ribbon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  type Curve = [number, number, number, number, number, number, number, number];

  interface Pulse {
    index: number;
    p: number;
    speed: number;
    wait: number;
  }

  const LINES = 38;
  const PULSES = 4;

  function point(c: Curve, t: number): [number, number] {
    const u = 1 - t;
    const a = u * u * u;
    const b = 3 * u * u * t;
    const d = 3 * u * t * t;
    const e = t * t * t;
    return [a * c[0] + b * c[2] + d * c[4] + e * c[6], a * c[1] + b * c[3] + d * c[5] + e * c[7]];
  }

  function rgba(color: string, alpha: number): string {
    const value = parseInt(color.trim().replace("#", ""), 16);
    return `rgba(${(value >> 16) & 255}, ${(value >> 8) & 255}, ${value & 255}, ${alpha})`;
  }

  function start(canvas: HTMLCanvasElement) {
    const context = canvas.getContext("2d");
    const scope = canvas.closest<HTMLElement>(".panel") ?? canvas.parentElement;
    if (!context || !scope) return;
    const ctx = context;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let width = 0;
    let height = 0;
    let target = { x: 0, y: 0 };
    let visible = false;
    let clock = 0;
    let last = performance.now();
    let palette = read();

    function read() {
      const style = getComputedStyle(document.documentElement);
      return {
        line: style.getPropertyValue("--flow-line").trim() || "#9a9282",
        accent: style.getPropertyValue("--accent").trim() || "#ee7a43",
        glow: style.getPropertyValue("--accent-2").trim() || "#f6b16c",
        light: document.documentElement.dataset.theme === "light",
      };
    }

    function fit() {
      const rect = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      const mark = scope!.querySelector<HTMLElement>("[data-ribbon-target]")?.getBoundingClientRect();
      target = mark
        ? { x: mark.left - rect.left + mark.width * 0.1, y: mark.top - rect.top + mark.height * 0.62 }
        : { x: width * 0.9, y: height * 0.2 };
    }

    // Fine lines rise from below and gather into the logo mark
    function curve(index: number, time: number): Curve {
      const s = index / (LINES - 1);
      const wave = Math.sin(time * 0.4 + s * 4.2);
      const drift = Math.cos(time * 0.33 + s * 2.6);
      const x0 = width * (0.02 + s * 0.8);
      const y0 = height + 20;
      const x3 = target.x;
      const y3 = target.y + (s - 0.5) * 6;
      const x1 = x0 + (x3 - x0) * 0.35 + wave * 14;
      const y1 = y0 - (y0 - y3) * 0.25;
      const x2 = x3 - (x3 - x0) * 0.3 + drift * 10;
      const y2 = y3 + (y0 - y3) * 0.3 - s * 18;
      return [x0, y0, x1, y1, x2, y2, x3, y3];
    }

    const pulses: Pulse[] = Array.from({ length: PULSES }, (_, k) => ({
      index: (k * 11 + 5) % LINES,
      p: (k * 0.29) % 1,
      speed: 0.12 + k * 0.015,
      wait: 0,
    }));

    function draw(time: number) {
      ctx.clearRect(0, 0, width, height);
      if (width === 0 || height === 0) return;
      const strength = palette.light ? 1.3 : 1;
      const gradient = ctx.createLinearGradient(width * 0.3, height, target.x, target.y);
      gradient.addColorStop(0, rgba(palette.line, 0));
      gradient.addColorStop(0.55, rgba(palette.line, 0.08 * strength));
      gradient.addColorStop(1, rgba(palette.accent, 0.3 * strength));
      ctx.strokeStyle = gradient;
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i < LINES; i += 1) {
        const c = curve(i, time);
        ctx.moveTo(c[0], c[1]);
        ctx.bezierCurveTo(c[2], c[3], c[4], c[5], c[6], c[7]);
      }
      ctx.stroke();

      if (reduced.matches) return;
      ctx.lineCap = "round";
      for (const pulse of pulses) {
        if (pulse.wait > 0) continue;
        const c = curve(pulse.index, time);
        const length = 0.14;
        let previous = point(c, Math.max(0, pulse.p - length));
        for (let step = 1; step <= 12; step += 1) {
          const t = Math.min(1, Math.max(0, pulse.p - length + (length * step) / 12));
          const next = point(c, t);
          const share = step / 12;
          ctx.strokeStyle = rgba(palette.glow, share * share * 0.45 * strength);
          ctx.lineWidth = 0.8 + share * 0.6;
          ctx.beginPath();
          ctx.moveTo(previous[0], previous[1]);
          ctx.lineTo(next[0], next[1]);
          ctx.stroke();
          previous = next;
        }
      }
    }

    function advance(delta: number) {
      for (const pulse of pulses) {
        if (pulse.wait > 0) {
          pulse.wait -= delta;
          continue;
        }
        pulse.p += pulse.speed * delta;
        if (pulse.p < 1) continue;
        pulse.p = 0;
        pulse.index = Math.floor(Math.random() * LINES);
        pulse.wait = 0.6 + Math.random() * 2;
      }
    }

    function frame(now: number) {
      const delta = Math.min(now - last, 64) / 1000;
      last = now;
      if (visible && !document.hidden && !reduced.matches) {
        clock += delta;
        advance(delta);
        draw(clock);
      }
      requestAnimationFrame(frame);
    }

    const refresh = () => {
      fit();
      draw(clock);
    };

    refresh();
    void document.fonts.ready.then(refresh);
    requestAnimationFrame(frame);
    new ResizeObserver(refresh).observe(scope);
    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
    }).observe(canvas);
    new MutationObserver(() => {
      palette = read();
      draw(clock);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }

  document.querySelectorAll<HTMLCanvasElement>("[data-ribbon]").forEach(start);
</script>
