<canvas class="ribbon" data-ribbon aria-hidden="true"></canvas>

<style>
  .ribbon {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 80px), transparent);
  }
</style>

<script>
  type Curve = [number, number, number, number, number, number, number, number];

  interface Pulse {
    lane: "in" | "out";
    index: number;
    p: number;
    speed: number;
    wait: number;
  }

  const INPUT = 40;
  const OUTPUT = 26;
  const PULSES = 6;

  function point(c: Curve, t: number): [number, number] {
    const u = 1 - t;
    const a = u * u * u;
    const b = 3 * u * u * t;
    const d = 3 * u * t * t;
    const e = t * t * t;
    return [a * c[0] + b * c[2] + d * c[4] + e * c[6], a * c[1] + b * c[3] + d * c[5] + e * c[7]];
  }

  function rgba(color: string, alpha: number): string {
    const value = parseInt(color.trim().replace("#", ""), 16);
    return `rgba(${(value >> 16) & 255}, ${(value >> 8) & 255}, ${value & 255}, ${alpha})`;
  }

  function start(canvas: HTMLCanvasElement) {
    const context = canvas.getContext("2d");
    const footer = canvas.parentElement;
    if (!context || !footer) return;
    const ctx = context;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let width = 0;
    let height = 0;
    let visible = false;
    let clock = 0;
    let last = performance.now();
    let palette = read();

    function read() {
      const style = getComputedStyle(document.documentElement);
      return {
        line: style.getPropertyValue("--flow-line").trim() || "#9a9282",
        accent: style.getPropertyValue("--accent").trim() || "#ee7a43",
        glow: style.getPropertyValue("--accent-2").trim() || "#f6b16c",
        light: document.documentElement.dataset.theme === "light",
      };
    }

    // The stream stays above the wordmark so the wordmark is never crossed
    function fit() {
      const stop = footer!.querySelector<HTMLElement>("[data-ribbon-stop]");
      const footerTop = footer!.getBoundingClientRect().top;
      const limit = stop ? stop.getBoundingClientRect().top - footerTop : footer!.clientHeight;
      canvas.style.height = `${Math.max(0, limit)}px`;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = footer!.clientWidth;
      height = Math.max(0, limit);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    }

    const waist = () => ({ x: width * 0.7, y: height * 0.56 });

    // Direction of the stream where it is narrowest, shared by both halves so it passes through smoothly
    function flow() {
      const w = waist();
      const dx = width * 0.95 - w.x;
      const dy = -30 - w.y;
      const length = Math.hypot(dx, dy) || 1;
      return { dx: dx / length, dy: dy / length, nx: -dy / length, ny: dx / length };
    }

    // Many fine lines sweep in from below and draw together into a narrow stream
    function inputCurve(index: number, time: number): Curve {
      const s = index / (INPUT - 1);
      const w = waist();
      const d = flow();
      const wave = Math.sin(time * 0.4 + s * 4.2);
      const drift = Math.cos(time * 0.34 + s * 2.8);
      const x0 = width * (0.36 + s * 0.3);
      const y0 = height + 30;
      const reach = width * 0.1;
      const spread = height * 0.2 * (s - 0.5) + drift * 6;
      const x1 = x0 + (w.x - x0) * 0.5 + wave * 18;
      const y1 = y0 - (y0 - w.y) * 0.25;
      const x2 = w.x - d.dx * reach + d.nx * spread;
      const y2 = w.y - d.dy * reach + d.ny * spread;
      const x3 = w.x + d.nx * (s - 0.5) * 10;
      const y3 = w.y + d.ny * (s - 0.5) * 10;
      return [x0, y0, x1, y1, x2, y2, x3, y3];
    }

    // Past the narrow point the lines cross over and open out toward the upper right corner
    function outputCurve(index: number, time: number): Curve {
      const s = index / (OUTPUT - 1);
      const w = waist();
      const d = flow();
      const wave = Math.sin(time * 0.46 + s * 3.4);
      const x0 = w.x + d.nx * (s - 0.5) * 8;
      const y0 = w.y + d.ny * (s - 0.5) * 8;
      const reach = width * 0.08;
      const spread = height * 0.1 * (0.5 - s);
      const x1 = w.x + d.dx * reach + d.nx * spread;
      const y1 = w.y + d.dy * reach + d.ny * spread;
      const x3 = width * (0.84 + s * 0.22);
      const y3 = -30;
      const x2 = x3 - width * 0.06 + wave * 14;
      const y2 = y3 + height * 0.3;
      return [x0, y0, x1, y1, x2, y2, x3, y3];
    }

    const pulses: Pulse[] = Array.from({ length: PULSES }, (_, k) => ({
      lane: k % 3 === 0 ? "out" : "in",
      index: (k * 11) % INPUT,
      p: (k * 0.37) % 1,
      speed: 0.1 + ((k * 0.13) % 0.08),
      wait: 0,
    }));

    function curveFor(pulse: Pulse, time: number): Curve {
      return pulse.lane === "in"
        ? inputCurve(pulse.index % INPUT, time)
        : outputCurve(pulse.index % OUTPUT, time);
    }

    function draw(time: number) {
      ctx.clearRect(0, 0, width, height);
      if (width === 0 || height === 0) return;
      const w = waist();
      const strength = palette.light ? 1.25 : 1;
      ctx.lineWidth = 1;

      const inbound = ctx.createLinearGradient(width * 0.5, height, w.x, w.y);
      inbound.addColorStop(0, rgba(palette.line, 0));
      inbound.addColorStop(0.5, rgba(palette.line, 0.1 * strength));
      inbound.addColorStop(1, rgba(palette.accent, 0.34 * strength));
      ctx.strokeStyle = inbound;
      ctx.beginPath();
      for (let i = 0; i < INPUT; i += 1) {
        const c = inputCurve(i, time);
        ctx.moveTo(c[0], c[1]);
        ctx.bezierCurveTo(c[2], c[3], c[4], c[5], c[6], c[7]);
      }
      ctx.stroke();

      const outbound = ctx.createLinearGradient(w.x, w.y, width, 0);
      outbound.addColorStop(0, rgba(palette.accent, 0.32 * strength));
      outbound.addColorStop(0.55, rgba(palette.line, 0.1 * strength));
      outbound.addColorStop(1, rgba(palette.line, 0));
      ctx.strokeStyle = outbound;
      ctx.beginPath();
      for (let i = 0; i < OUTPUT; i += 1) {
        const c = outputCurve(i, time);
        ctx.moveTo(c[0], c[1]);
        ctx.bezierCurveTo(c[2], c[3], c[4], c[5], c[6], c[7]);
      }
      ctx.stroke();

      if (reduced.matches) return;
      ctx.lineCap = "round";
      for (const pulse of pulses) {
        if (pulse.wait > 0) continue;
        const curve = curveFor(pulse, time);
        const length = pulse.lane === "in" ? 0.12 : 0.16;
        let previous = point(curve, Math.max(0, pulse.p - length));
        for (let step = 1; step <= 12; step += 1) {
          const t = Math.min(1, Math.max(0, pulse.p - length + (length * step) / 12));
          const next = point(curve, t);
          const share = step / 12;
          ctx.strokeStyle = rgba(palette.glow, share * share * 0.5 * strength);
          ctx.lineWidth = 0.8 + share * 0.7;
          ctx.beginPath();
          ctx.moveTo(previous[0], previous[1]);
          ctx.lineTo(next[0], next[1]);
          ctx.stroke();
          previous = next;
        }
      }
    }

    function advance(delta: number) {
      for (const pulse of pulses) {
        if (pulse.wait > 0) {
          pulse.wait -= delta;
          continue;
        }
        pulse.p += pulse.speed * delta;
        if (pulse.p < 1) continue;
        // A pulse that reaches the narrow stream carries on into the opening lines
        if (pulse.lane === "in") {
          pulse.lane = "out";
          pulse.index = Math.floor(Math.random() * OUTPUT);
        } else {
          pulse.lane = "in";
          pulse.index = Math.floor(Math.random() * INPUT);
          pulse.wait = 0.4 + Math.random() * 1.6;
        }
        pulse.p = 0;
      }
    }

    function frame(now: number) {
      const delta = Math.min(now - last, 64) / 1000;
      last = now;
      if (visible && !document.hidden && !reduced.matches) {
        clock += delta;
        advance(delta);
        draw(clock);
      }
      requestAnimationFrame(frame);
    }

    const refresh = () => {
      fit();
      draw(clock);
    };

    refresh();
    void document.fonts.ready.then(refresh);
    requestAnimationFrame(frame);
    new ResizeObserver(refresh).observe(footer);
    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
    }).observe(footer);
    new MutationObserver(() => {
      palette = read();
      draw(clock);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }

  document.querySelectorAll<HTMLCanvasElement>("[data-ribbon]").forEach(start);
</script>
