---
interface Pad {
  x: number;
  y: number;
  label: string;
}

// Routes between file pads, drawn like import edges on a board
const routes = [
  "M -20 40 H 236 Q 252 40 252 56 V 92 Q 252 108 268 108 H 520",
  "M 520 108 H 600 Q 616 108 616 92 V 56 Q 616 40 632 40 H 1040",
  "M 1180 40 H 1480",
  "M 700 724 H 1120 Q 1136 724 1136 708 V 692 Q 1136 676 1152 676 H 1480",
  "M -20 470 H 20 Q 36 470 36 486 V 720",
  "M 1110 54 V 120 Q 1110 136 1126 136 H 1480",
  "M 1480 560 H 1400 Q 1384 560 1384 576 V 640",
];

const pads: Pad[] = [
  { x: 1040, y: 26, label: "graph/rank.ts" },
];

const nodes = [
  [520, 108],
  [252, 74],
  [616, 74],
  [700, 724],
  [1136, 700],
  [36, 600],
  [1110, 95],
  [1384, 640],
];

const pulses = [
  { route: 1, duration: 9, delay: 0 },
  { route: 3, duration: 8, delay: 2.5 },
  { route: 5, duration: 7, delay: 4 },
  { route: 0, duration: 7, delay: 1.2 },
];
---

<svg class="traces" viewBox="0 0 1440 880" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <g class="routes">
    {routes.map((d) => <path d={d} />)}
  </g>
  <g class="pads">
    {
      pads.map((pad) => (
        <g>
          <rect x={pad.x} y={pad.y} width="140" height="28" rx="6" />
          <text x={pad.x + 14} y={pad.y + 18}>
            {pad.label}
          </text>
        </g>
      ))
    }
  </g>
  <g class="nodes">
    {nodes.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.5" />)}
  </g>
  <g class="pulses" data-pulses>
    {
      pulses.map((pulse) => (
        <circle r="2.6">
          <animateMotion
            dur={`${pulse.duration}s`}
            begin={`${pulse.delay}s`}
            repeatCount="indefinite"
            path={routes[pulse.route]}
          />
          <animate
            attributeName="opacity"
            values="0;1;1;0"
            keyTimes="0;0.1;0.85;1"
            dur={`${pulse.duration}s`}
            begin={`${pulse.delay}s`}
            repeatCount="indefinite"
          />
        </circle>
      ))
    }
  </g>
</svg>

<style>
  .traces {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image: radial-gradient(ellipse 42% 48% at 32% 48%, transparent 30%, #000 85%);
  }

  .routes path {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  .pads rect {
    fill: var(--bg);
    stroke: var(--line);
  }

  .pads text {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-3);
  }

  .nodes circle {
    fill: var(--bg);
    stroke: var(--text-3);
    stroke-width: 1;
  }

  .pulses circle {
    fill: var(--accent);
    opacity: 0;
  }
</style>

<script>
  // SMIL motion ignores the reduced motion media query, so the pulses are removed instead
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll("[data-pulses]").forEach((group) => group.remove());
  }
</script>
