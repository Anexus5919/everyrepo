---
import type { SiteWiki } from "@everyrepo/core";
import { shortSha } from "../lib/format.ts";
import { buildPreview, pageTree, readablePages, repoKey } from "../lib/preview.ts";
import { samplePage } from "../lib/showcase.ts";

interface Props {
  wikis: SiteWiki[];
}
const { wikis } = Astro.props;

const panels = (
  await Promise.all(
    wikis.map(async (wiki) => {
      const page = samplePage(wiki);
      if (!page) return null;
      const tree = pageTree(wiki);
      return {
        wiki,
        key: repoKey(wiki.repo),
        preview: await buildPreview(page),
        tree,
        openGroup: tree.find(
          (group) =>
            group.slug === page.slug || group.children.some((child) => child.slug === page.slug),
        )?.slug,
        count: readablePages(wiki).length,
      };
    }),
  )
).filter((panel) => panel !== null);
---

<div class="wiki-preview" data-preview>
  <div class="tabs" role="tablist" aria-label="Wikis">
    {
      panels.map((panel, index) => (
        <button
          class="tab"
          type="button"
          role="tab"
          id={`wiki-tab-${index}`}
          aria-controls={`wiki-panel-${index}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          title={panel.wiki.repo}
          data-tab={index}
        >
          {panel.wiki.name}
          <span class="tab-count">{panel.count}</span>
        </button>
      ))
    }
  </div>

  {
    panels.map((panel, index) => (
      <div
        class="panel"
        role="tabpanel"
        id={`wiki-panel-${index}`}
        aria-labelledby={`wiki-tab-${index}`}
        data-panel
        data-key={panel.key}
        data-current={panel.preview.slug}
        hidden={index !== 0}
      >
        <aside class="tree">
          <label class="filter">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="6.5" />
              <path d="M16 16l4.5 4.5" />
            </svg>
            <span class="sr-only">Filter pages</span>
            <input type="search" placeholder={`Filter ${panel.count} pages`} data-filter />
          </label>

          <nav class="tree-scroll" aria-label={`${panel.wiki.name} pages`} data-tree>
            {panel.tree.map((group) => (
              <div class="group" data-group data-open={group.slug === panel.openGroup ? "true" : "false"}>
                <div class="group-row">
                  {group.written ? (
                    <button
                      type="button"
                      class="page top"
                      data-slug={group.slug}
                      aria-current={group.slug === panel.preview.slug ? "page" : undefined}
                    >
                      {group.title}
                    </button>
                  ) : (
                    <span class="page top static">{group.title}</span>
                  )}
                  {group.children.length > 0 && (
                    <button
                      type="button"
                      class="toggle"
                      aria-expanded={group.slug === panel.openGroup ? "true" : "false"}
                      aria-label={`Pages in ${group.title}`}
                      data-toggle
                    >
                      <span class="toggle-count">{group.children.length}</span>
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                  )}
                </div>
                {group.children.length > 0 && (
                  <div class="children" data-children>
                    {group.children.map((child) => (
                      <button
                        type="button"
                        class="page child"
                        data-slug={child.slug}
                        aria-current={child.slug === panel.preview.slug ? "page" : undefined}
                      >
                        {child.title}
                      </button>
                    ))}
                  </div>
                )}
              </div>
            ))}
            <p class="tree-empty" data-empty hidden>
              No page matches
            </p>
          </nav>

          <div class="tree-foot">
            <span>{panel.wiki.repo}</span>
            <span class="mono">{shortSha(panel.wiki.sha)}</span>
          </div>
        </aside>

        <article class="article" data-article>
          <header class="page-head">
            <h3 class="page-title" data-title>
              {panel.preview.title}
            </h3>
            <span class="meta" data-meta>
              Written from {panel.preview.excerpts} excerpts of the code
            </span>
          </header>
          <div class="prose" data-prose set:html={panel.preview.html} />
        </article>

        <aside class="source" aria-label="Cited source" data-sources set:html={panel.preview.sourcesHtml} />
      </div>
    ))
  }
</div>

<script>
  interface PreviewPage {
    slug: string;
    title: string;
    excerpts: number;
    html: string;
    sourcesHtml: string;
    active: number | null;
  }

  document.querySelectorAll<HTMLElement>("[data-preview]").forEach((preview) => {
    const tabs = [...preview.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...preview.querySelectorAll<HTMLElement>("[data-panel]")];
    const cache = new Map<string, PreviewPage>();

    function markChips(panel: HTMLElement, number: string) {
      panel.querySelectorAll<HTMLElement>(".cite").forEach((chip) => {
        chip.classList.toggle("is-active", chip.dataset.cite === number);
      });
    }

    function showSource(panel: HTMLElement, number: string, replay = true) {
      if (panel.dataset.source === number) return;
      panel.dataset.source = number;
      panel.querySelectorAll<HTMLElement>("[data-source]").forEach((item) => {
        const active = item.dataset.source === number;
        item.hidden = !active;
        item.classList.remove("is-entering");
        if (active && replay) {
          void item.offsetWidth;
          item.classList.add("is-entering");
        }
      });
      markChips(panel, number);
    }

    function selectTab(index: number, focus = false) {
      tabs.forEach((tab, position) => {
        const selected = position === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel, position) => {
        panel.hidden = position !== index;
      });
    }

    function setGroup(group: HTMLElement, open: boolean) {
      group.dataset.open = String(open);
      group.querySelector("[data-toggle]")?.setAttribute("aria-expanded", String(open));
    }

    function markCurrent(panel: HTMLElement, slug: string) {
      panel.dataset.current = slug;
      panel.querySelectorAll<HTMLElement>("[data-slug]").forEach((button) => {
        if (button.dataset.slug === slug) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
      });
    }

    function render(panel: HTMLElement, page: PreviewPage) {
      const article = panel.querySelector<HTMLElement>("[data-article]")!;
      panel.querySelector("[data-title]")!.textContent = page.title;
      panel.querySelector("[data-meta]")!.textContent =
        `Written from ${page.excerpts} excerpts of the code`;
      panel.querySelector("[data-prose]")!.innerHTML = page.html;
      panel.querySelector("[data-sources]")!.innerHTML = page.sourcesHtml;
      delete panel.dataset.source;
      if (page.active !== null) showSource(panel, String(page.active), false);
      article.scrollTop = 0;
      article.classList.remove("is-loading");
      article.classList.remove("is-arriving");
      void article.offsetWidth;
      article.classList.add("is-arriving");
    }

    async function openPage(panel: HTMLElement, slug: string) {
      if (panel.dataset.current === slug) return;
      markCurrent(panel, slug);
      const key = `${panel.dataset.key}/${slug}`;
      const cached = cache.get(key);
      if (cached) {
        render(panel, cached);
        return;
      }
      const article = panel.querySelector<HTMLElement>("[data-article]")!;
      article.classList.add("is-loading");
      try {
        const response = await fetch(`/preview/${key}.json`);
        if (!response.ok) throw new Error(String(response.status));
        const page = (await response.json()) as PreviewPage;
        cache.set(key, page);
        if (panel.dataset.current === slug) render(panel, page);
      } catch {
        article.classList.remove("is-loading");
        panel.querySelector("[data-prose]")!.innerHTML =
          "<p>This page could not be loaded. Try again in a moment.</p>";
      }
    }

    function filter(panel: HTMLElement, text: string) {
      const query = text.trim().toLowerCase();
      let shown = 0;
      panel.querySelectorAll<HTMLElement>("[data-group]").forEach((group) => {
        const top = group.querySelector<HTMLElement>(".top");
        const topMatch = !query || (top?.textContent ?? "").toLowerCase().includes(query);
        let childMatches = 0;
        group.querySelectorAll<HTMLElement>(".child").forEach((child) => {
          const match = !query || topMatch || (child.textContent ?? "").toLowerCase().includes(query);
          child.hidden = !match;
          if (match) childMatches += 1;
        });
        group.hidden = !topMatch && childMatches === 0;
        if (!group.hidden) shown += 1;
        if (query) group.dataset.filtered = "true";
        else delete group.dataset.filtered;
      });
      panel.querySelector<HTMLElement>("[data-empty]")!.hidden = shown > 0;
    }

    for (const panel of panels) {
      const visibleSource = panel.querySelector<HTMLElement>("[data-source]:not([hidden])");
      if (visibleSource?.dataset.source) {
        panel.dataset.source = visibleSource.dataset.source;
        markChips(panel, visibleSource.dataset.source);
      }
      panel.querySelector<HTMLInputElement>("[data-filter]")?.addEventListener("input", (event) => {
        filter(panel, (event.target as HTMLInputElement).value);
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(index));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const step = event.key === "ArrowRight" ? 1 : -1;
        selectTab((index + step + tabs.length) % tabs.length, true);
      });
    });

    preview.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const panel = target.closest<HTMLElement>("[data-panel]");
      if (!panel) return;
      const toggle = target.closest<HTMLElement>("[data-toggle]");
      if (toggle) {
        const group = toggle.closest<HTMLElement>("[data-group]")!;
        setGroup(group, group.dataset.open !== "true");
        return;
      }
      const page = target.closest<HTMLElement>("[data-slug]");
      if (page?.dataset.slug) {
        const group = page.closest<HTMLElement>("[data-group]");
        if (group && page.classList.contains("top")) setGroup(group, true);
        void openPage(panel, page.dataset.slug);
        return;
      }
      const chip = target.closest<HTMLElement>(".cite");
      if (chip?.dataset.cite) {
        event.preventDefault();
        showSource(panel, chip.dataset.cite);
      }
    });

    // Pointing at a citation shows its source
    const onPoint = (event: Event) => {
      const chip = (event.target as HTMLElement).closest<HTMLElement>(".cite");
      const panel = chip?.closest<HTMLElement>("[data-panel]");
      if (chip?.dataset.cite && panel) showSource(panel, chip.dataset.cite);
    };
    preview.addEventListener("mouseover", onPoint);
    preview.addEventListener("focusin", onPoint);
  });
</script>

<style is:global>
  .wiki-preview {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .wiki-preview .tabs {
    display: flex;
    align-items: stretch;
    height: 44px;
    padding: 0 10px;
    border-bottom: 1px solid var(--line-soft);
    background: var(--bg-raise);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .wiki-preview .tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    border: 0;
    background: transparent;
    font-size: var(--t-ui);
    color: var(--text-3);
    white-space: nowrap;
    cursor: pointer;
    transition: color 140ms ease;
  }

  .wiki-preview .tab::after {
    content: "";
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: transparent;
    transition: background-color 160ms ease;
  }

  .wiki-preview .tab:hover {
    color: var(--text-2);
  }

  .wiki-preview .tab[aria-selected="true"] {
    color: var(--text);
  }

  .wiki-preview .tab[aria-selected="true"]::after {
    background: var(--accent);
  }

  .wiki-preview .tab-count {
    min-width: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--panel-2);
    font-size: 11px;
    line-height: 18px;
    color: var(--text-3);
    text-align: center;
  }

  /* The reader takes the room left in the viewport so the section fits on one screen */
  .wiki-preview .panel {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) 380px;
    height: clamp(380px, calc(100svh - var(--header) - 290px), 620px);
  }

  .wiki-preview .panel[hidden] {
    display: none;
  }

  .wiki-preview .tree {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-right: 1px solid var(--line-soft);
    background: var(--bg-raise);
  }

  .wiki-preview .filter {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 12px 12px 6px;
    padding: 0 10px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text-3);
    transition: border-color 140ms ease;
  }

  .wiki-preview .filter:focus-within {
    border-color: var(--text-3);
  }

  .wiki-preview .filter input {
    flex-grow: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: var(--t-caption);
    color: var(--text);
  }

  .wiki-preview .filter input::placeholder {
    color: var(--text-3);
  }

  .wiki-preview .tree-scroll {
    flex: 1 1 auto;
    min-height: 0;
    padding: 4px 8px 12px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .wiki-preview .group-row {
    display: flex;
    align-items: center;
  }

  .wiki-preview .page {
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    padding: 6px 10px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    font-size: 13.5px;
    line-height: 1.35;
    text-align: left;
    color: var(--text-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .wiki-preview .page.top {
    font-weight: 500;
    color: var(--text);
  }

  .wiki-preview .page.static {
    cursor: default;
  }

  .wiki-preview .page.child {
    padding-left: 24px;
  }

  .wiki-preview button.page:hover {
    background: var(--panel-2);
    color: var(--text);
  }

  .wiki-preview .page[aria-current="page"] {
    background: var(--accent-soft);
    color: var(--text);
  }

  .wiki-preview .page[aria-current="page"]::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    bottom: 7px;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .wiki-preview .toggle {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 26px;
    padding: 0 6px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
  }

  .wiki-preview .toggle:hover {
    color: var(--text);
    background: var(--panel-2);
  }

  .wiki-preview .toggle-count {
    font-size: 11px;
  }

  /* The chevron turns to point at the pages it reveals */
  .wiki-preview .toggle svg {
    transition: transform 180ms var(--ease-out);
  }

  .wiki-preview [data-open="true"] > .group-row .toggle svg,
  .wiki-preview [data-filtered="true"] > .group-row .toggle svg {
    transform: rotate(90deg);
  }

  .wiki-preview .children {
    display: none;
    margin: 2px 0 6px;
  }

  .wiki-preview [data-open="true"] > .children,
  .wiki-preview [data-filtered="true"] > .children {
    display: block;
  }

  .wiki-preview .tree-empty {
    padding: 10px;
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .wiki-preview .tree-foot {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 14px;
    border-top: 1px solid var(--line-soft);
    font-size: var(--t-label);
    color: var(--text-3);
    white-space: nowrap;
    overflow: hidden;
  }

  .wiki-preview .article {
    min-height: 0;
    padding: 26px 36px 40px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    transition: opacity 140ms ease;
  }

  .wiki-preview .article.is-loading {
    opacity: 0.45;
  }

  .wiki-preview .article.is-arriving .prose,
  .wiki-preview .article.is-arriving .page-head {
    animation: page-arrive 260ms ease;
  }

  /* No fill mode, so the page is fully shown even when the animation does not run */
  @keyframes page-arrive {
    from {
      opacity: 0.3;
    }
  }

  .wiki-preview .page-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-bottom: 18px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--line-soft);
  }

  .wiki-preview .page-title {
    font-size: var(--t-h3);
    line-height: 1.2;
  }

  .wiki-preview .meta {
    font-size: var(--t-label);
    color: var(--text-3);
  }

  .wiki-preview .prose {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .wiki-preview .prose p,
  .wiki-preview .prose li {
    font-size: var(--t-small);
    line-height: 1.75;
    color: var(--text-2);
  }

  .wiki-preview .prose h2 {
    margin-top: 12px;
    font-size: var(--t-h4);
    line-height: 1.3;
  }

  .wiki-preview .prose h3 {
    margin-top: 6px;
    font-family: var(--font-sans);
    font-size: var(--t-small);
    font-weight: 600;
  }

  .wiki-preview .prose ul,
  .wiki-preview .prose ol {
    margin: 0;
    padding-left: 20px;
  }

  .wiki-preview .prose a:not(.cite) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .wiki-preview .prose .code-block {
    padding: 12px 14px;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    background: var(--bg-raise);
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  /* A run of citations sits in one pill with thin dividers instead of separate chips */
  .wiki-preview .cite-group {
    display: inline-flex;
    margin: 0 1px;
    border-radius: 4px;
    background: var(--accent-soft);
    vertical-align: 3px;
  }

  .wiki-preview .cite-group .cite {
    margin: 0;
    min-width: 17px;
    border-radius: 0;
    background: transparent;
    vertical-align: 0;
  }

  .wiki-preview .cite-group .cite + .cite {
    box-shadow: -1px 0 0 var(--accent-line);
  }

  .wiki-preview .cite-group .cite:first-child {
    border-radius: 4px 0 0 4px;
  }

  .wiki-preview .cite-group .cite:last-child {
    border-radius: 0 4px 4px 0;
  }

  .wiki-preview .cite-group .cite:hover,
  .wiki-preview .cite-group .cite.is-active {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .wiki-preview .source {
    min-width: 0;
    min-height: 0;
    border-left: 1px solid var(--line-soft);
    background: var(--bg-raise);
    overflow: hidden;
  }

  .wiki-preview .source-item {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .wiki-preview .source-item[hidden] {
    display: none;
  }

  .wiki-preview .source-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line-soft);
  }

  .wiki-preview .badge {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--t-label);
  }

  .wiki-preview .source-file {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .wiki-preview .name,
  .wiki-preview .folder {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wiki-preview .name {
    font-size: var(--t-caption);
    color: var(--text);
  }

  .wiki-preview .folder {
    font-size: 11px;
    color: var(--text-3);
    direction: rtl;
    text-align: left;
  }

  .wiki-preview .lines {
    font-size: var(--t-label);
    color: var(--text-3);
  }

  .wiki-preview .lines:hover,
  .wiki-preview .more:hover {
    color: var(--accent);
  }

  .wiki-preview .code {
    position: relative;
    flex-grow: 1;
    min-height: 0;
    padding: 12px 0;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  /* A newly shown source is read top to bottom once, then the tint clears */
  .wiki-preview .is-entering .code::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--accent-soft);
    animation: read-through 560ms var(--ease-out) forwards;
  }

  @keyframes read-through {
    0% {
      clip-path: inset(0 0 100% 0);
      opacity: 1;
    }
    60% {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
    100% {
      clip-path: inset(0 0 0 0);
      opacity: 0;
    }
  }

  .wiki-preview .code .shiki {
    font-size: 12px;
    padding-right: 16px;
  }

  .wiki-preview .code .line::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 38px;
    margin-right: 14px;
    text-align: right;
    color: var(--text-3);
    opacity: 0.6;
  }

  .wiki-preview .more {
