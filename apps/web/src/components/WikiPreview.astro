---
import type { SiteWiki } from "@everyrepo/core";
import { languageForPath, shortSha } from "../lib/format.ts";
import { highlight, renderMarkdown, sections } from "../lib/markdown.ts";

interface Props {
  wiki: SiteWiki;
  slug: string;
  focus: string;
}
const { wiki, slug, focus } = Astro.props;

const EXCERPT_LINES = 24;
const page = wiki.wikiPages.find((candidate) => candidate.slug === slug);
if (!page?.markdown) throw new Error(`Page ${slug} has no text`);

const parts = sections(page.markdown);
const firstParagraph = (body: string) =>
  body
    .split(/\n{2,}/)
    .find((block) => block.trim() !== "" && !block.trim().startsWith("```")) ?? "";
const intro = firstParagraph(parts[0]?.body ?? "");
const section =
  parts.find((part) => part.heading?.toLowerCase().includes(focus)) ?? parts[1] ?? parts[0]!;
const introHtml = await renderMarkdown(intro);
const sectionHtml = await renderMarkdown(firstParagraph(section.body));

const cited = [
  ...new Set(
    [...`${introHtml}${sectionHtml}`.matchAll(/data-cite="(\d+)"/g)].map((match) => Number(match[1])),
  ),
];
const sources = await Promise.all(
  page.citations
    .filter((citation) => cited.includes(citation.number))
    .map(async (citation) => {
      const lines = citation.excerpt.split("\n");
      return {
        ...citation,
        name: citation.path.split("/").pop() ?? citation.path,
        folder: citation.path.split("/").slice(0, -1).join("/"),
        html: await highlight(lines.slice(0, EXCERPT_LINES).join("\n"), languageForPath(citation.path)),
        more: Math.max(0, lines.length - EXCERPT_LINES),
      };
    }),
);
const active = [...sectionHtml.matchAll(/data-cite="(\d+)"/g)].map((match) => Number(match[1]))[0] ?? sources[0]?.number;

const parent = wiki.wikiPages.find((candidate) => candidate.slug === page.parentSlug);
const siblings = parent
  ? wiki.wikiPages.filter((candidate) => candidate.parentSlug === parent.slug)
  : [page];
---

<div class="window" data-preview>
  <div class="window-bar">
    <span class="path">
      <span>everyrepo.me</span><span class="sep">/</span><span>{wiki.repo}</span><span class="sep"
        >/</span
      ><span class="current">{page.slug}</span>
    </span>
    <span class="commit mono">commit {shortSha(wiki.sha)}</span>
  </div>
  <div class="window-body">
    <aside class="tree" aria-label="Pages">
      <span class="tree-title serif">{wiki.name} wiki</span>
      {parent && <span class="tree-parent">{parent.title}</span>}
      {
        siblings.map((sibling) => (
          <span class:list={["tree-item", sibling.slug === page.slug && "is-current"]}>
            {sibling.title}
          </span>
        ))
      }
      <span class="tree-more">{wiki.pages} pages in this wiki</span>
    </aside>

    <article class="article">
      {parent && <span class="crumbs">{parent.title}</span>}
      <h3 class="page-title">{page.title}</h3>
      <span class="meta">Written from {page.citations.length} excerpts of the code</span>
      <div class="prose" set:html={introHtml} />
      <h4 class="section-title">{section.heading}</h4>
      <div class="prose" set:html={sectionHtml} />
    </article>

    <aside class="source" aria-label="Cited source">
      {
        sources.map((source) => (
          <div class="source-item" data-source={source.number} hidden={source.number !== active}>
            <div class="source-head">
              <span class="badge mono">{source.number}</span>
              <span class="source-file">
                <span class="mono name">{source.name}</span>
                <span class="mono folder">{source.folder}</span>
              </span>
              <a class="lines mono" href={source.url} target="_blank" rel="noopener">
                lines {source.startLine}-{source.endLine}
              </a>
            </div>
            <div
              class="code"
              style={`counter-reset: line ${source.startLine - 1}`}
              set:html={source.html}
            />
            {source.more > 0 && (
              <a class="more" href={source.url} target="_blank" rel="noopener">
                {source.more} more lines on GitHub
              </a>
            )}
          </div>
        ))
      }
    </aside>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-preview]").forEach((preview) => {
    let current = "";
    const select = (number: string) => {
      if (number === current) return;
      current = number;
      preview.querySelectorAll<HTMLElement>("[data-source]").forEach((item) => {
        const active = item.dataset.source === number;
        item.hidden = !active;
        item.classList.remove("is-entering");
        if (active) {
          void item.offsetWidth;
          item.classList.add("is-entering");
        }
      });
      preview.querySelectorAll<HTMLElement>(".cite").forEach((chip) => {
        chip.classList.toggle("is-active", chip.dataset.cite === number);
      });
    };
    const initial = preview.querySelector<HTMLElement>("[data-source]:not([hidden])");
    if (initial?.dataset.source) {
      current = initial.dataset.source;
      preview.querySelectorAll<HTMLElement>(".cite").forEach((chip) => {
        chip.classList.toggle("is-active", chip.dataset.cite === current);
      });
    }
    const chipFrom = (target: EventTarget | null) =>
      (target as HTMLElement | null)?.closest<HTMLElement>(".cite") ?? null;
    // Pointing at a citation shows its source; clicking keeps the page in place
    preview.addEventListener("mouseover", (event) => {
      const chip = chipFrom(event.target);
      if (chip?.dataset.cite) select(chip.dataset.cite);
    });
    preview.addEventListener("focusin", (event) => {
      const chip = chipFrom(event.target);
      if (chip?.dataset.cite) select(chip.dataset.cite);
    });
    preview.addEventListener("click", (event) => {
      const chip = chipFrom(event.target);
      if (!chip?.dataset.cite) return;
      event.preventDefault();
      select(chip.dataset.cite);
    });
  });
</script>

<style>
  .window {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 44px;
    padding: 0 18px;
    border-bottom: 1px solid var(--line-soft);
    background: var(--bg-raise);
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .path {
    display: flex;
    gap: 8px;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .sep {
    color: var(--line);
  }

  .current {
    color: var(--text);
  }

  .commit {
    font-size: var(--t-label);
    white-space: nowrap;
  }

  .window-body {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr) 400px;
    min-height: 540px;
  }

  .tree {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 22px 14px;
    border-right: 1px solid var(--line-soft);
    font-size: var(--t-ui);
  }

  .tree-title {
    padding: 0 8px 12px;
    font-size: var(--t-h4);
  }

  .tree-parent {
    padding: 6px 8px;
    color: var(--text);
    font-weight: 500;
  }

  .tree-item {
    padding: 6px 8px 6px 20px;
    border-radius: var(--radius);
    color: var(--text-2);
  }

  .tree-item.is-current {
    background: var(--accent-soft);
    color: var(--text);
    font-weight: 500;
  }

  .tree-more {
    margin-top: auto;
    padding: 12px 8px 0;
    border-top: 1px solid var(--line-soft);
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .article {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 30px 40px 36px;
  }

  .crumbs {
    font-size: var(--t-ui);
    color: var(--text-3);
  }

  .page-title {
    font-size: var(--t-h2);
    line-height: 1.15;
  }

  .meta {
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .section-title {
    margin-top: 10px;
    font-size: var(--t-h3);
    line-height: 1.25;
  }

  .prose :global(p) {
    font-size: var(--t-small);
    line-height: 1.75;
    color: var(--text-2);
  }

  .source {
    border-left: 1px solid var(--line-soft);
    background: var(--bg-raise);
    min-width: 0;
  }

  .source-item {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .source-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line-soft);
  }

  .badge {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--t-label);
  }

  .source-file {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .name,
  .folder {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .name {
    font-size: var(--t-caption);
    color: var(--text);
  }

  .folder {
    font-size: 11px;
    color: var(--text-3);
    direction: rtl;
    text-align: left;
  }

  .lines {
    font-size: var(--t-label);
    color: var(--text-3);
  }

  .lines:hover {
    color: var(--accent);
  }

  .code {
    position: relative;
    flex-grow: 1;
    padding: 14px 0;
    overflow: auto;
    max-height: 470px;
  }

  /* A new source is read top to bottom once, then the tint clears */
  .is-entering .code::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--accent-soft);
    animation: read-through 560ms var(--ease-out) forwards;
  }

  @keyframes read-through {
    0% {
      clip-path: inset(0 0 100% 0);
      opacity: 1;
    }
    60% {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
    100% {
      clip-path: inset(0 0 0 0);
      opacity: 0;
    }
  }

  .code :global(.shiki) {
    font-size: 12px;
  }

  .code :global(pre) {
    padding-right: 16px;
  }

  .code :global(.line)::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 40px;
    margin-right: 14px;
    text-align: right;
    color: var(--text-3);
    opacity: 0.6;
  }

  .more {
    padding: 10px 16px 14px;
    border-top: 1px solid var(--line-soft);
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .more:hover {
    color: var(--accent);
  }

  @media (max-width: 1100px) {
    .window-body {
      grid-template-columns: minmax(0, 1fr) 360px;
    }

    .tree {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .commit {
      display: none;
    }

    .window-body {
      grid-template-columns: 1fr;
    }

    .source {
      border-left: 0;
      border-top: 1px solid var(--line-soft);
    }

    .article {
      padding: 24px 20px;
    }
  }
</style>
