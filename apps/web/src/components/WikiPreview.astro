---
import type { SiteWiki } from "@everyrepo/core";
import { languageForPath, shortSha } from "../lib/format.ts";
import { highlight, renderMarkdown } from "../lib/markdown.ts";
import { samplePage, sampleText } from "../lib/showcase.ts";

interface Props {
  wikis: SiteWiki[];
}
const { wikis } = Astro.props;

const EXCERPT_LINES = 28;

const samples = (
  await Promise.all(
    wikis.map(async (wiki) => {
      const page = samplePage(wiki);
      if (!page) return null;
      const text = sampleText(page);
      const introHtml = await renderMarkdown(text.intro);
      const parts = await Promise.all(
        text.parts.map(async (part) => ({ heading: part.heading, html: await renderMarkdown(part.body) })),
      );
      const html = `${introHtml}${parts.map((part) => part.html).join("")}`;
      const cited = [...new Set([...html.matchAll(/data-cite="(\d+)"/g)].map((match) => Number(match[1])))];
      const sources = await Promise.all(
        page.citations
          .filter((citation) => cited.includes(citation.number))
          .map(async (citation) => {
            const lines = citation.excerpt.split("\n");
            return {
              ...citation,
              name: citation.path.split("/").pop() ?? citation.path,
              folder: citation.path.split("/").slice(0, -1).join("/"),
              html: await highlight(lines.slice(0, EXCERPT_LINES).join("\n"), languageForPath(citation.path)),
              more: Math.max(0, lines.length - EXCERPT_LINES),
            };
          }),
      );
      const parent = wiki.wikiPages.find((candidate) => candidate.slug === page.parentSlug);
      const siblings = parent
        ? wiki.wikiPages.filter((candidate) => candidate.parentSlug === parent.slug)
        : wiki.wikiPages.filter((candidate) => candidate.parentSlug === null);
      return { wiki, page, introHtml, parts, sources, parent, siblings, active: cited[0] };
    }),
  )
).filter((sample) => sample !== null);

// Wikis with the most pages come first
samples.sort((a, b) => b.wiki.pages - a.wiki.pages);
---

<div class="window" data-preview>
  <div class="tabs" role="tablist" aria-label="Wikis">
    {
      samples.map((sample, index) => (
        <button
          class="tab"
          type="button"
          role="tab"
          id={`wiki-tab-${index}`}
          aria-controls={`wiki-panel-${index}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          data-tab={index}
        >
          <span class="tab-owner">{sample.wiki.owner}/</span>
          <span class="tab-name">{sample.wiki.name}</span>
        </button>
      ))
    }
    <span class="tabs-note">Point at a number to read its source</span>
  </div>

  {
    samples.map((sample, index) => (
      <div
        class="panel"
        role="tabpanel"
        id={`wiki-panel-${index}`}
        aria-labelledby={`wiki-tab-${index}`}
        data-panel={index}
        hidden={index !== 0}
      >
        <div class="window-body">
          <aside class="tree" aria-label="Pages">
            <span class="tree-title serif">{sample.wiki.name} wiki</span>
            {sample.parent && <span class="tree-parent">{sample.parent.title}</span>}
            <div class="tree-list">
              {sample.siblings.slice(0, 9).map((sibling) => (
                <span
                  class:list={[
                    "tree-item",
                    sample.parent && "is-child",
                    sibling.slug === sample.page.slug && "is-current",
                  ]}
                >
                  {sibling.title}
                </span>
              ))}
            </div>
            <span class="tree-more">
              {sample.wiki.pages} pages <span class="mono">· {shortSha(sample.wiki.sha)}</span>
            </span>
          </aside>

          <article class="article">
            {sample.parent && <span class="crumbs">{sample.parent.title}</span>}
            <h3 class="page-title">{sample.page.title}</h3>
            <span class="meta">Written from {sample.page.citations.length} excerpts of the code</span>
            <div class="prose" set:html={sample.introHtml} />
            {sample.parts.map((part) => (
              <>
                <h4 class="section-title">{part.heading}</h4>
                <div class="prose" set:html={part.html} />
              </>
            ))}
          </article>

          <aside class="source" aria-label="Cited source">
            {sample.sources.map((source) => (
              <div class="source-item" data-source={source.number} hidden={source.number !== sample.active}>
                <div class="source-head">
                  <span class="badge mono">{source.number}</span>
                  <span class="source-file">
                    <span class="mono name">{source.name}</span>
                    <span class="mono folder">{source.folder}</span>
                  </span>
                  <a class="lines mono" href={source.url} target="_blank" rel="noopener">
                    lines {source.startLine}-{source.endLine}
                  </a>
                </div>
                <div
                  class="code"
                  style={`counter-reset: line ${source.startLine - 1}`}
                  set:html={source.html}
                />
                {source.more > 0 && (
                  <a class="more" href={source.url} target="_blank" rel="noopener">
                    {source.more} more lines on GitHub
                  </a>
                )}
              </div>
            ))}
          </aside>
        </div>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-preview]").forEach((preview) => {
    const tabs = [...preview.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...preview.querySelectorAll<HTMLElement>("[data-panel]")];

    function markChips(panel: HTMLElement, number: string) {
      panel.querySelectorAll<HTMLElement>(".cite").forEach((chip) => {
        chip.classList.toggle("is-active", chip.dataset.cite === number);
      });
    }

    function showSource(panel: HTMLElement, number: string) {
      if (panel.dataset.current === number) return;
      panel.dataset.current = number;
      panel.querySelectorAll<HTMLElement>("[data-source]").forEach((item) => {
        const active = item.dataset.source === number;
        item.hidden = !active;
        item.classList.remove("is-entering");
        if (active) {
          void item.offsetWidth;
          item.classList.add("is-entering");
        }
      });
      markChips(panel, number);
    }

    function selectTab(index: number, focus = false) {
      tabs.forEach((tab, position) => {
        const selected = position === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel, position) => {
        panel.hidden = position !== index;
      });
    }

    for (const panel of panels) {
      const initial = panel.querySelector<HTMLElement>("[data-source]:not([hidden])");
      if (initial?.dataset.source) {
        panel.dataset.current = initial.dataset.source;
        markChips(panel, initial.dataset.source);
      }
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(index));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const step = event.key === "ArrowRight" ? 1 : -1;
        selectTab((index + step + tabs.length) % tabs.length, true);
      });
    });

    const chipFrom = (target: EventTarget | null) =>
      (target as HTMLElement | null)?.closest<HTMLElement>(".cite") ?? null;
    const panelFrom = (element: HTMLElement) => element.closest<HTMLElement>("[data-panel]");

    // Pointing at a citation shows its source; clicking keeps the reader on the page
    preview.addEventListener("mouseover", (event) => {
      const chip = chipFrom(event.target);
      const panel = chip && panelFrom(chip);
      if (chip?.dataset.cite && panel) showSource(panel, chip.dataset.cite);
    });
    preview.addEventListener("focusin", (event) => {
      const chip = chipFrom(event.target);
      const panel = chip && panelFrom(chip);
      if (chip?.dataset.cite && panel) showSource(panel, chip.dataset.cite);
    });
    preview.addEventListener("click", (event) => {
      const chip = chipFrom(event.target);
      const panel = chip && panelFrom(chip);
      if (!chip?.dataset.cite || !panel) return;
      event.preventDefault();
      showSource(panel, chip.dataset.cite);
    });
  });
</script>

<style>
  .window {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .tabs {
    display: flex;
    align-items: stretch;
    height: 46px;
    padding: 0 8px;
    border-bottom: 1px solid var(--line-soft);
    background: var(--bg-raise);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tab {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 16px;
    border: 0;
    background: transparent;
    font-size: var(--t-ui);
    color: var(--text-3);
    white-space: nowrap;
    cursor: pointer;
    transition: color 140ms ease;
  }

  .tab::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: transparent;
    transition: background-color 160ms ease;
  }

  .tab:hover {
    color: var(--text-2);
  }

  .tab[aria-selected="true"] {
    color: var(--text);
  }

  .tab[aria-selected="true"]::after {
    background: var(--accent);
  }

  .tab-owner {
    color: var(--text-3);
  }

  .tabs-note {
    display: flex;
    align-items: center;
    margin-left: auto;
    padding: 0 10px;
    font-size: var(--t-label);
    color: var(--text-3);
    white-space: nowrap;
  }

  /* The window takes the room left in the viewport so the section fits on one screen */
  .window-body {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr) 400px;
    height: clamp(360px, calc(100svh - var(--header) - 300px), 600px);
  }

  .tree {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 0;
    padding: 22px 14px;
    border-right: 1px solid var(--line-soft);
    font-size: var(--t-ui);
  }

  .tree-title {
    padding: 0 8px 12px;
    font-size: var(--t-h4);
  }

  .tree-parent {
    padding: 6px 8px;
    color: var(--text);
    font-weight: 500;
  }

  .tree-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 0;
    overflow: hidden;
  }

  .tree-item {
    padding: 6px 8px;
    border-radius: var(--radius);
    color: var(--text-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tree-item.is-child {
    padding-left: 20px;
  }

  .tree-item.is-current {
    background: var(--accent-soft);
    color: var(--text);
    font-weight: 500;
  }

  .tree-more {
    margin-top: auto;
    padding: 12px 8px 0;
    border-top: 1px solid var(--line-soft);
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .article {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 0;
    padding: 28px 40px 36px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .crumbs {
    font-size: var(--t-ui);
    color: var(--text-3);
  }

  .page-title {
    font-size: var(--t-h2);
    line-height: 1.15;
  }

  .meta {
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .section-title {
    margin-top: 12px;
    font-size: var(--t-h3);
    line-height: 1.25;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .prose :global(p),
  .prose :global(li) {
    font-size: var(--t-small);
    line-height: 1.75;
    color: var(--text-2);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0;
    padding-left: 20px;
  }

  .prose :global(h3) {
    margin-top: 6px;
    font-size: var(--t-h4);
  }

  .prose :global(.code-block) {
    padding: 12px 14px;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    background: var(--bg-raise);
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .source {
    border-left: 1px solid var(--line-soft);
    background: var(--bg-raise);
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .source-item {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .source-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line-soft);
  }

  .badge {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--t-label);
  }

  .source-file {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .name,
  .folder {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .name {
    font-size: var(--t-caption);
    color: var(--text);
  }

  .folder {
    font-size: 11px;
    color: var(--text-3);
    direction: rtl;
    text-align: left;
  }

  .lines {
    font-size: var(--t-label);
    color: var(--text-3);
  }

  .lines:hover {
    color: var(--accent);
  }

  .code {
    position: relative;
    flex-grow: 1;
    min-height: 0;
    padding: 14px 0;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  /* A newly shown source is read top to bottom once, then the tint clears */
  .is-entering .code::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--accent-soft);
    animation: read-through 560ms var(--ease-out) forwards;
  }

  @keyframes read-through {
    0% {
      clip-path: inset(0 0 100% 0);
      opacity: 1;
    }
    60% {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
    100% {
      clip-path: inset(0 0 0 0);
      opacity: 0;
    }
  }

  .code :global(.shiki) {
    font-size: 12px;
  }

  .code :global(pre) {
    padding-right: 16px;
  }

  .code :global(.line)::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 40px;
    margin-right: 14px;
    text-align: right;
    color: var(--text-3);
    opacity: 0.6;
  }

  .more {
    padding: 10px 16px 14px;
    border-top: 1px solid var(--line-soft);
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .more:hover {
    color: var(--accent);
  }

  @media (max-width: 1100px) {
    .window-body {
      grid-template-columns: minmax(0, 1fr) 360px;
    }

    .tree,
    .tabs-note {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .window-body {
      grid-template-columns: 1fr;
      height: auto;
    }

    .article {
      max-height: 520px;
      padding: 24px 20px;
    }

    .code {
      max-height: 360px;
    }

    .source {
      border-left: 0;
      border-top: 1px solid var(--line-soft);
    }
  }
</style>
