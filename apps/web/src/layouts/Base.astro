---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import "../styles/palettes.css";
import Footer from "../components/Footer.astro";
import Guide from "../components/Guide.astro";
import Header from "../components/Header.astro";
import { PALETTES } from "../lib/palettes.ts";

interface Props {
  title: string;
  description: string;
  // Full screen sections that scrolling settles on, used by the home page
  snap?: boolean;
  wide?: boolean;
}
const { title, description, snap = false, wide = false } = Astro.props;
const paletteIds = PALETTES.map((palette) => palette.id);
---

<!doctype html>
<html lang="en" data-theme="dark" data-snap={snap ? "true" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
        if (saved === "system") {
          const light = window.matchMedia("(prefers-color-scheme: light)").matches;
          document.documentElement.dataset.theme = light ? "light" : "dark";
        }
      } catch {}
    </script>
    <script is:inline define:vars={{ paletteIds }}>
      // A palette named in the address wins over the saved one, so a palette can be shared as a link
      try {
        const named = new URLSearchParams(location.search).get("palette");
        const saved = localStorage.getItem("palette");
        const palette = paletteIds.includes(named) ? named : saved;
        if (named && paletteIds.includes(named)) localStorage.setItem("palette", named);
        if (paletteIds.includes(palette) && palette !== "ember") {
          document.documentElement.dataset.palette = palette;
        }
      } catch {}
    </script>
  </head>
  <body>
    <div class="rails" aria-hidden="true"></div>
    <Header wide={wide} />
    <main>
      <slot />
    </main>
    <Footer />
    <Guide />
  </body>
</html>
