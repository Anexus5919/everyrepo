---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Admin: EveryRepo"
  description="The owner's dashboard for builds, requests and wikis."
  guide={false}
  noindex
>
  <section class="section admin-page">
    <div class="frame admin-frame" data-admin-root>
      <p class="admin-empty">Checking your access</p>
      <noscript><p class="admin-empty">The dashboard needs JavaScript.</p></noscript>
    </div>
  </section>
</Base>

<script>
  import { mountAdminPage } from "../../lib/admin-page.ts";

  mountAdminPage();
</script>

<style is:global>
  .admin-page {
    padding-block: 36px 96px;
  }

  .admin-frame {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .admin-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  .admin-title {
    margin-top: 8px;
    font-size: var(--t-title);
    line-height: 1.1;
  }

  .admin-top-actions,
  .admin-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .admin-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-soft);
  }

  .admin-tab {
    padding: 8px 14px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: var(--t-ui);
    color: var(--text-2);
    cursor: pointer;
  }

  .admin-tab:hover {
    color: var(--text);
    background: var(--panel);
  }

  .admin-tab[aria-current="page"] {
    border-color: var(--line);
    background: var(--panel-2);
    color: var(--text);
  }

  .admin-notice {
    font-size: var(--t-caption);
    color: var(--text-2);
  }

  .admin-notice:empty {
    display: none;
  }

  .admin-notice[data-tone="error"] {
    color: var(--accent-2);
  }

  .admin-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .admin-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-raise);
  }

  .admin-card h2 {
    font-size: var(--t-h4);
  }

  .admin-card h3 {
    font-size: var(--t-small);
  }

  .admin-card p {
    font-size: var(--t-small);
    color: var(--text-2);
  }

  .admin-help,
  .admin-card .admin-help {
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .admin-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
  }

  .admin-fact {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--line-soft);
    border-radius: 10px;
    background: var(--bg-raise);
  }

  .admin-fact strong {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 400;
    color: var(--text);
  }

  .admin-fact span {
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .admin-table-wrap {
    overflow-x: auto;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-caption);
  }

  .admin-table th {
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
    text-align: left;
    white-space: nowrap;
    color: var(--text-3);
  }

  .admin-table td {
    padding: 10px;
    border-bottom: 1px solid var(--line-soft);
    vertical-align: top;
    color: var(--text-2);
  }

  .admin-table td > strong {
    color: var(--text);
    font-weight: 500;
  }

  .admin-repo {
    color: var(--text);
    border-bottom: 1px solid var(--line);
  }

  .admin-repo:hover {
    border-color: var(--text-3);
  }

  .admin-note {
    display: block;
    margin-top: 3px;
    font-size: 12px;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }

  .admin-pill {
    display: inline-block;
    padding: 1px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 12px;
    white-space: nowrap;
  }

  .admin-pill.is-good {
    border-color: var(--accent-line);
    color: var(--accent);
  }

  .admin-pill.is-warn {
    border-color: var(--accent-line);
    color: var(--accent-2);
  }

  .admin-pill.is-bad {
    border-color: var(--accent-2);
    background: var(--accent-soft);
    color: var(--text);
  }

  .admin-pill.is-quiet {
    color: var(--text-3);
  }

  .admin-button {
    padding: 5px 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    font: inherit;
    font-size: 12.5px;
    color: var(--text);
    cursor: pointer;
    white-space: nowrap;
  }

  .admin-button:hover {
    border-color: var(--text-3);
  }

  .admin-button.is-solid {
    border-color: transparent;
    background: var(--button-bg);
    color: var(--button-ink);
  }

  .admin-button.is-danger {
    border-color: var(--accent-line);
    color: var(--accent-2);
  }

  .admin-button[disabled] {
    cursor: progress;
    opacity: 0.6;
  }

  .admin-meter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .admin-meter-bar {
    display: inline-block;
    width: 90px;
    height: 5px;
    border-radius: 3px;
    background: var(--panel-2);
    overflow: hidden;
  }

  .admin-meter-bar span {
    display: block;
    height: 100%;
    background: var(--accent);
  }

  .admin-add {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .admin-input {
    flex: 1 1 260px;
    height: 38px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    font: inherit;
    font-size: var(--t-small);
    color: var(--text);
  }

  .admin-input:focus {
    border-color: var(--text-3);
    outline: none;
  }

  .admin-preview .preview-card {
    display: flex;
    gap: 14px;
    padding: 14px 16px;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    font-size: var(--t-caption);
  }

  .admin-preview .preview-main {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .admin-preview .monogram {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .admin-preview svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
  }

  .admin-markdown {
    max-height: 520px;
    overflow: auto;
    padding: 14px;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    background: var(--panel);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    white-space: pre-wrap;
    color: var(--text-2);
  }

  .admin-empty {
    font-size: var(--t-small);
    color: var(--text-3);
  }

  .admin-gate {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    max-width: 520px;
    padding-block: 24px;
  }

  .admin-gate h1 {
    font-size: var(--t-title);
  }

  .admin-gate p {
    font-size: var(--t-small);
    color: var(--text-2);
  }
</style>
