---
import BookIcon from "../components/BookIcon.astro";
import Method from "../components/Method.astro";
import Pipeline from "../components/Pipeline.astro";
import RepoGrid from "../components/RepoGrid.astro";
import WikiPreview from "../components/WikiPreview.astro";
import Base from "../layouts/Base.astro";
import { formatCount } from "../lib/format.ts";
import { citationLinks, pipelineItems, readingMinutes } from "../lib/showcase.ts";
import { loadRepos, loadWiki } from "../lib/site-data.ts";

const repos = loadRepos();
const ready = repos.filter((repo) => repo.status === "ready");
if (ready.length === 0) throw new Error("No written wiki to show; run the site command");
const wikis = new Map(ready.map((repo) => [repo.repo, loadWiki(repo.repo)]));
// Wikis with the most pages lead the showcase
const wikiList = [...wikis.values()].sort((a, b) => b.pages - a.pages);

const totalFiles = repos.reduce((sum, repo) => sum + repo.files, 0);
const totalPages = ready.reduce((sum, repo) => sum + repo.pages, 0);
const minutes = readingMinutes(wikiList);
const readingTime = minutes >= 90 ? `${(minutes / 60).toFixed(1)} h` : `${minutes} min`;
const citations = citationLinks(wikiList);
const items = pipelineItems(wikiList, (count) => `${formatCount(count)} files`);

const outlines = Object.fromEntries(
  [...wikis.entries()].map(([repo, item]) => [
    repo,
    item.wikiPages.filter((page) => page.parentSlug === null).map((page) => page.title),
  ]),
);

const knownRepos = repos.map((repo) => ({ repo: repo.repo, status: repo.status }));
const examples = ready.slice(0, 3).map((repo) => repo.repo);
---

<Base
  snap
  title="EveryRepo: a wiki for any public GitHub repository"
  description="EveryRepo writes a wiki for public GitHub repositories. Every sentence links to the lines of code it was written from."
>
  <section class="hero snap">
    <div class="frame hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Codebase wikis, cited to the line</span>
        <h1 class="display">Read any codebase like you <em>already work there.</em></h1>
        <p class="lead">
          EveryRepo writes a wiki for public GitHub repositories: how the code is organized, which
          files to open first, and a source for every sentence, linked to the exact lines.
        </p>
        <form class="open-form" id="open" data-open-form>
          <label class="field" data-open-field>
            <span class="sr-only">Repository</span>
            <span class="field-icon" aria-hidden="true">
              <svg
                class="search"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                ><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg
              >
              <svg
                class="match"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path pathLength="1" d="M5 12.5l4.5 4.5L19 7.5"></path></svg
              >
            </span>
            <input
              name="repo"
              placeholder="owner/repo or a GitHub link"
              autocomplete="off"
              spellcheck="false"
              data-open-input
            />
            <kbd class="mono">/</kbd>
          </label>
          <button class="btn btn-solid btn-lg book-trigger" type="submit"
            >Open the wiki <BookIcon /></button
          >
        </form>
        <p class="form-note" data-open-note aria-live="polite"></p>
        <div class="try">
          <span>Try</span>
          {
            examples.map((repo) => (
              <a class="pill mono" href={`/${repo}`}>
                {repo}
              </a>
            ))
          }
        </div>
      </div>

      <div class="hero-art">
        <Pipeline items={items} />
      </div>
    </div>

    <div class="frame hero-stats">
      <div class="stat">
        <span class="value">{formatCount(totalFiles)}</span>
        <span class="label">files read across {repos.length} repositories</span>
      </div>
      <div class="stat">
        <span class="value">{totalPages}</span>
        <span class="label">wiki pages written from them</span>
      </div>
      <div class="stat">
        <span class="value">{readingTime}</span>
        <span class="label">of reading across {ready.length} wikis</span>
      </div>
      <div class="stat">
        <span class="value">{formatCount(citations)}</span>
        <span class="label">citations that open the exact lines</span>
      </div>
    </div>
  </section>

  <section class="section block snap" id="wiki">
    <div class="frame">
      <div class="block-head">
        <div>
          <span class="eyebrow"><span class="num">01</span> A wiki page</span>
          <h2 class="title">Every sentence points at the code it came from.</h2>
        </div>
        <p class="block-text">
          Real wikis from the guide. Pick a repository, open any page from its sidebar and point
          at a number to read the lines it cites.
        </p>
      </div>
      <WikiPreview wikis={wikiList} />
    </div>
  </section>

  <section class="section block snap" id="guide">
    <div class="frame">
      <div class="block-head">
        <div>
          <span class="eyebrow"><span class="num">02</span> In the guide</span>
          <h2 class="title">Wikis are built once and shared with everyone.</h2>
        </div>
        <p class="block-text">
          Anyone can request a public repository. The first request starts the reading; everyone
          after gets the finished wiki.
        </p>
      </div>
    </div>
    <div class="frame grid-frame">
      <RepoGrid repos={repos} outlines={outlines} />
    </div>
  </section>

  <section class="section block snap" id="method">
    <div class="frame">
      <div class="block-head">
        <div>
          <span class="eyebrow"><span class="num">03</span> Method</span>
          <h2 class="title">How a page is made.</h2>
        </div>
        <p class="block-text">
          Pages come from the code itself at a pinned commit. Point at a step to see it happen.
        </p>
      </div>
    </div>
    <div class="frame grid-frame">
      <Method />
    </div>
  </section>

  <script is:inline type="application/json" id="known-repos" set:html={JSON.stringify(knownRepos)} />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-open-form]");
  const field = document.querySelector<HTMLElement>("[data-open-field]");
  const input = document.querySelector<HTMLInputElement>("[data-open-input]");
  const note = document.querySelector<HTMLElement>("[data-open-note]");
  const known = JSON.parse(document.getElementById("known-repos")?.textContent ?? "[]") as Array<{
    repo: string;
    status: string;
  }>;

  const parse = (value: string) => {
    const match = /(?:github\.com[/:])?([\w.-]+)\/([\w.-]+?)(?:\.git)?\/?(?:[#?].*)?$/i.exec(
      value.trim(),
    );
    return match ? `${match[1]}/${match[2]}` : null;
  };
  const lookup = (name: string | null) =>
    name ? known.find((item) => item.repo.toLowerCase() === name.toLowerCase()) : undefined;

  // The search icon turns into a check once the text names a wiki that is ready to open
  input?.addEventListener("input", () => {
    const entry = lookup(parse(input.value));
    field?.classList.toggle("is-match", entry?.status === "ready");
    if (note) note.textContent = "";
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!input || !note) return;
    const name = parse(input.value);
    if (!name) {
      note.textContent = "Enter a repository as owner/repo or paste its GitHub link.";
      return;
    }
    const entry = lookup(name);
    if (entry?.status === "ready") {
      window.location.href = `/${entry.repo}`;
    } else if (entry) {
      note.textContent = `${entry.repo} is already in the queue. Its wiki is being prepared.`;
    } else {
      note.textContent = `${name} is not in the guide yet. Requests open soon.`;
    }
  });

  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement;
    if (event.key !== "/" || target.closest("input, textarea")) return;
    event.preventDefault();
    input?.focus();
  });
</script>

<style>
  .hero {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero-inner {
    flex-grow: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: 16px;
    padding: 40px 24px 32px;
  }

  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .display {
    font-size: var(--t-display);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 600px;
  }

  .display em {
    font-style: italic;
    color: var(--accent-2);
  }

  .lead {
    max-width: 540px;
    font-size: var(--t-lead);
    line-height: 1.55;
    color: var(--text-2);
  }

  .open-form {
    display: flex;
    gap: 10px;
    width: 100%;
    max-width: 560px;
  }

  .field {
    flex-grow: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 52px;
    padding: 0 12px 0 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--text-3);
    transition: border-color 160ms ease;
  }

  .field:focus-within {
    border-color: var(--text-3);
  }

  .field.is-match {
    border-color: var(--accent);
  }

  .field-icon {
    display: grid;
  }

  .field-icon svg {
    grid-area: 1 / 1;
    transition: opacity 160ms ease;
  }

  .match {
    color: var(--accent);
    opacity: 0;
  }

  .match path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 320ms var(--ease-out) 60ms;
  }

  .is-match .search {
    opacity: 0;
  }

  .is-match .match {
    opacity: 1;
  }

  .is-match .match path {
    stroke-dashoffset: 0;
  }

  .field input {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: var(--t-small);
    color: var(--text);
  }

  .field input::placeholder {
    color: var(--text-3);
  }

  kbd {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: var(--t-label);
    color: var(--text-3);
  }

  .form-note {
    margin-top: -12px;
    font-size: var(--t-caption);
    color: var(--accent-2);
  }

  .form-note:empty {
    display: none;
  }

  .try {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--t-ui);
    color: var(--text-3);
  }

  .pill {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--t-caption);
    color: var(--text-2);
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }

  .pill:hover {
    border-color: var(--text-3);
    color: var(--text);
  }

  .hero-art {
    position: relative;
    width: 100%;
  }

  .hero-stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-soft);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 22px 24px 26px;
  }

  .stat + .stat {
    border-left: 1px solid var(--line-soft);
  }

  .value {
    font-family: var(--font-serif);
    font-size: var(--t-h2);
    line-height: 1.1;
  }

  .label {
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .block {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 40px;
  }

  .block > .frame:first-child {
    padding: 0 24px;
  }

  .block-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: end;
    gap: 48px;
    margin-bottom: 28px;
  }

  .title {
    margin-top: 16px;
    font-size: var(--t-title);
    line-height: 1.08;
    letter-spacing: -0.015em;
    max-width: 680px;
  }

  .block-text {
    font-size: var(--t-small);
    line-height: 1.65;
    color: var(--text-2);
    max-width: 420px;
  }


  @media (max-width: 1000px) {
    .hero-inner {
      grid-template-columns: 1fr;
      padding-top: 48px;
    }

    .block-head {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat:nth-child(3) {
      border-left: 0;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line-soft);
    }
  }

  @media (max-width: 560px) {
    .open-form {
      flex-direction: column;
    }

    .block {
      padding-block: 48px;
    }

    .block > .frame:first-child {
      padding: 0;
    }
  }
</style>
