---
import AskShowcase from "../components/AskShowcase.astro";
import Audience from "../components/Audience.astro";
import BookIcon from "../components/BookIcon.astro";
import DiagramShowcase from "../components/DiagramShowcase.astro";
import Faq from "../components/Faq.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Method from "../components/Method.astro";
import Pipeline from "../components/Pipeline.astro";
import RepoOpener from "../components/RepoOpener.astro";
import RepoGrid from "../components/RepoGrid.astro";
import WikiPreview from "../components/WikiPreview.astro";
import Base from "../layouts/Base.astro";
import { layoutDiagram, parseFlowchart } from "../lib/diagram.ts";
import { formatCount } from "../lib/format.ts";
import {
  askExample,
  citationLinks,
  diagramExample,
  pipelineItems,
  readingMinutes,
} from "../lib/showcase.ts";
import { loadRepos, loadWiki } from "../lib/site-data.ts";

const repos = loadRepos();
const ready = repos.filter((repo) => repo.status === "ready");
if (ready.length === 0) throw new Error("No written wiki to show; run the site command");
const wikis = new Map(ready.map((repo) => [repo.repo, loadWiki(repo.repo)]));
// Wikis with the most pages lead the showcase
const wikiList = [...wikis.values()].sort((a, b) => b.pages - a.pages);

// Every figure counts written wikis only, so each one describes something a reader can open today
const explainedFiles = ready.reduce((sum, repo) => sum + repo.files, 0);
const largestRepo = Math.max(...ready.map((repo) => repo.files));
const averageMinutes = Math.round(readingMinutes(wikiList) / wikiList.length);
const citations = citationLinks(wikiList);
const terms = wikiList.reduce((sum, wiki) => sum + wiki.glossary.length, 0);
const items = pipelineItems(wikiList, (count) => `${formatCount(count)} files`);

const outlines = Object.fromEntries(
  [...wikis.entries()].map(([repo, item]) => [
    repo,
    item.wikiPages.filter((page) => page.parentSlug === null).map((page) => page.title),
  ]),
);

// Each showcase uses a different wiki than the one the reader preview opens on
const askWiki = wikiList[1] ?? wikiList[0]!;
const ask = askExample(askWiki) ?? wikiList.map(askExample).find(Boolean);
const measure = (source: string) => {
  const graph = parseFlowchart(source);
  if (!graph) return undefined;
  const layout = layoutDiagram(graph);
  return { boxes: layout.nodes.length, links: layout.edges.length, crossings: layout.crossings };
};
const diagram =
  diagramExample(
    wikiList.filter((wiki) => wiki.repo !== ask?.repo),
    measure,
  ) ?? diagramExample(wikiList, measure);
const waiting = repos.length - ready.length;

const askKinds = [
  { question: "How does this part work?", answer: "Explained from the code, with every claim cited." },
  {
    question: "Where should I start?",
    answer: "What the project is, how it is laid out and what to read first.",
  },
  {
    question: "Which issue can I pick up?",
    answer: "Open issues for newcomers, how serious each one is and the files it touches.",
  },
  { question: "What does this diagram show?", answer: "Every box and arrow, in plain words." },
];
const diagramPoints = [
  "Drawn from how files really import each other",
  "Point at a box to follow only its links",
  "Open any diagram full screen to explore it",
  "Ask for a plain explanation, box by box",
];

const examples = ready.slice(0, 3).map((repo) => repo.repo);
---

<Base
  snap
  title="EveryRepo: a wiki for any public GitHub repository"
  description="EveryRepo writes a wiki for public GitHub repositories. Every sentence links to the lines of code it was written from."
>
  <section class="hero snap">
    <div class="frame hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Codebase wikis, cited to the line</span>
        <h1 class="display">Read any codebase like you <em>already work there.</em></h1>
        <p class="lead">
          EveryRepo writes a wiki for public GitHub repositories: how the code is organized, which
          files to open first, and a source for every sentence, linked to the exact lines.
        </p>
        <div class="hero-opener" id="open">
          <RepoOpener id="hero-opener" variant="hero" shortcut label="Open the wiki" />
        </div>
        <div class="try">
          <span>Try</span>
          {
            examples.map((repo) => (
              <a class="pill mono" href={`/${repo}`}>
                {repo}
              </a>
            ))
          }
        </div>
      </div>

      <div class="hero-art">
        <Pipeline items={items} />
      </div>
    </div>

    <div class="frame hero-stats">
      <div class="stat">
        <span class="value">{formatCount(explainedFiles)}</span>
        <span class="label">files already read and explained for you</span>
      </div>
      <div class="stat">
        <span class="value">{averageMinutes} min</span>
        <span class="label">on average to read a whole repository, even at {formatCount(largestRepo)} files</span>
      </div>
      <div class="stat">
        <span class="value">{formatCount(citations)}</span>
        <span class="label">citations that open the exact lines behind a sentence</span>
      </div>
      <div class="stat">
        <span class="value">{terms}</span>
        <span class="label">project terms explained from the code, so jargon never stops you</span>
      </div>
    </div>
  </section>

  <section class="section block snap" id="wiki">
    <div class="frame">
      <div class="block-head">
        <div>
          <span class="eyebrow">Read a real page</span>
          <h2 class="title">Every sentence shows where it came from.</h2>
        </div>
        <p class="block-text">
          These are real wikis, not mockups. Pick a repository, open any page from its sidebar and
          point at a number to see the exact lines behind that sentence.
        </p>
      </div>
      <WikiPreview wikis={wikiList} />
    </div>
  </section>

  {
    ask && (
      <section class="section block snap" id="ask">
        <div class="frame split">
          <div class="split-copy">
            <span class="eyebrow">Ask the codebase</span>
            <h2 class="title">Ask in plain words. Check every answer.</h2>
            <p class="block-text">
              Answers are written from the repository's own code and wiki, and every claim links to
              the lines that support it. When the code does not say, the answer says so.
            </p>
            <dl class="ask-kinds">
              {askKinds.map((kind) => (
                <div class="ask-kind">
                  <dt>{kind.question}</dt>
                  <dd>{kind.answer}</dd>
                </div>
              ))}
            </dl>
          </div>
          <AskShowcase example={ask} />
        </div>
      </section>
    )
  }

  {
    diagram && (
      <section class="section block snap" id="diagrams">
        <div class="frame split split-reverse">
          <DiagramShowcase example={diagram} />
          <div class="split-copy">
            <span class="eyebrow">Diagrams</span>
            <h2 class="title">See how the pieces fit before you read a line.</h2>
            <p class="block-text">
              Pages that cover many files carry a map of how those files depend on each other. This
              one shows {diagram.boxes} files from {diagram.repo}. Point at any box.
            </p>
            <ul class="points">
              {diagramPoints.map((point) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M3 7.5l2.6 2.6L11 4.5" />
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="section block snap" id="features">
    <div class="frame">
      <div class="block-head">
        <div>
          <span class="eyebrow">In every wiki</span>
          <h2 class="title">Everything you need for your first week in a new codebase.</h2>
        </div>
        <p class="block-text">
          Each wiki comes with the same set of tools, whether the repository has two hundred files
          or twenty thousand.
        </p>
      </div>
      <FeatureGrid />
    </div>
  </section>

  <section class="section block snap" id="guide">
    <div class="frame">
      <div class="block-head">
        <div>
          <span class="eyebrow">Ready to read</span>
          <h2 class="title">Written once, open to everyone.</h2>
        </div>
        <p class="block-text">
          A wiki is written the first time a repository is requested. Everyone after that opens the
          finished pages straight away. <a class="inline-link" href="/queue/">See what is in the queue</a>.
        </p>
      </div>
    </div>
    <div class="frame grid-frame">
      <RepoGrid repos={repos} outlines={outlines} />
    </div>
  </section>

  <section class="section block snap" id="audience">
    <div class="frame">
      <div class="block-head">
        <div>
          <span class="eyebrow">Who it is for</span>
          <h2 class="title">Made for anyone opening code they did not write.</h2>
        </div>
        <p class="block-text">
          Whether you are fixing your first issue or deciding what to build on, you get the same
          cited explanation of how the project works.
        </p>
      </div>
      <Audience />
    </div>
  </section>

  <section class="section block snap" id="method">
    <div class="frame">
      <div class="block-head">
        <div>
          <span class="eyebrow">How it works</span>
          <h2 class="title">From source code to a page you can trust.</h2>
        </div>
        <p class="block-text">
          Every page is written from the code at a pinned commit and checked before it is
          published. Point at a step to see it happen.
        </p>
      </div>
    </div>
    <div class="frame grid-frame">
      <Method />
    </div>
  </section>

  <section class="section block snap" id="faq">
    <div class="frame split faq-split">
      <div class="split-copy">
        <span class="eyebrow">Questions</span>
        <h2 class="title">Good to know before you start.</h2>
        <p class="block-text">
          The short version: pick a repository, read with the sources open, and ask when something
          is unclear.
        </p>
        <div class="faq-actions">
          <a class="btn btn-solid book-trigger" href="#open" data-open-repo
            >Open a repository <BookIcon /></a
          >
          <button class="btn btn-line" type="button" data-guide-open>Take the tour</button>
        </div>
      </div>
      <Faq ready={ready.length} waiting={waiting} />
    </div>
  </section>

</Base>


<style>
  .hero {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero-inner {
    flex-grow: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: 16px;
    padding: 40px 24px 32px;
  }

  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .display {
    font-size: var(--t-display);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 600px;
  }

  .display em {
    font-style: italic;
    color: var(--accent-2);
  }

  .lead {
    max-width: 540px;
    font-size: var(--t-lead);
    line-height: 1.55;
    color: var(--text-2);
  }

  .inline-link {
    color: var(--text);
    border-bottom: 1px solid var(--line);
  }

  .inline-link:hover {
    border-color: var(--text-3);
  }

  .hero-opener {
    width: 100%;
    max-width: 560px;
    scroll-margin-top: calc(var(--header) + 24px);
  }

  .try {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--t-ui);
    color: var(--text-3);
  }

  .pill {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--t-caption);
    color: var(--text-2);
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }

  .pill:hover {
    border-color: var(--text-3);
    color: var(--text);
  }

  .hero-art {
    position: relative;
    width: 100%;
  }

  .hero-stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-soft);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 22px 24px 26px;
  }

  .stat + .stat {
    border-left: 1px solid var(--line-soft);
  }

  .value {
    font-family: var(--font-serif);
    font-size: var(--t-h2);
    line-height: 1.1;
  }

  .label {
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .block {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 40px;
  }

  .block > .frame:first-child {
    padding: 0 24px;
  }

  .block-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: end;
    gap: 48px;
    margin-bottom: 28px;
  }

  .title {
    margin-top: 16px;
    font-size: var(--t-title);
    line-height: 1.08;
    letter-spacing: -0.015em;
    max-width: 680px;
  }

  .block-text {
    font-size: var(--t-small);
    line-height: 1.65;
    color: var(--text-2);
    max-width: 420px;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: 64px;
    padding: 0 24px;
  }

  .split-reverse {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: 56px;
  }

  .faq-split {
    align-items: start;
  }

  .split-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .split-copy .block-text {
    margin-top: 18px;
  }

  .ask-kinds {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 28px 0 0;
    border-top: 1px solid var(--line-soft);
  }

  .ask-kind {
    padding: 14px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .ask-kind dt {
    font-family: var(--font-serif);
    font-size: var(--t-h4);
    color: var(--text);
  }

  .ask-kind dd {
    margin: 4px 0 0;
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .points {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--t-small);
    color: var(--text);
  }

  .points svg {
    flex-shrink: 0;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .faq-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  @media (max-width: 1000px) {
    .split,
    .split-reverse {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }

    .split-reverse > .split-copy {
      order: -1;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      padding-top: 48px;
    }

    .block-head {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat:nth-child(3) {
      border-left: 0;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line-soft);
    }
  }

  @media (max-width: 560px) {
    .block {
      padding-block: 48px;
    }

    .block > .frame:first-child,
    .split {
      padding: 0;
    }
  }
</style>
