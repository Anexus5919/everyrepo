---
import BookIcon from "../../components/BookIcon.astro";
import Base from "../../layouts/Base.astro";
---

<Base
  title="The queue: EveryRepo"
  description="Repositories being read and written right now, the line after them and wikis published recently."
>
  <section class="section queue-page">
    <div class="frame queue-frame">
      <header class="queue-head">
        <div>
          <span class="eyebrow">The queue</span>
          <h1 class="queue-title">Wikis being written for everyone.</h1>
          <p class="queue-lead">
            Every requested repository is read, written and checked here in turn. Smaller
            repositories go first, so one large build never holds up many small ones.
          </p>
        </div>
        <button class="btn btn-solid book-trigger" type="button" data-open-repo>
          Request a repository <BookIcon />
        </button>
      </header>
      <p class="queue-summary" aria-live="polite" data-queue-summary>Loading the queue</p>
      <p class="queue-offline" data-queue-offline hidden></p>
      <div class="queue-root" data-queue-root>
        <noscript><p class="queue-empty">This page needs JavaScript to show the live queue.</p></noscript>
      </div>
    </div>
  </section>
</Base>

<script>
  import { mountQueuePage } from "../../lib/queue-page.ts";

  mountQueuePage();
</script>

<style is:global>
  .queue-page {
    padding-block: 48px 96px;
  }

  .queue-frame {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 900px;
  }

  .queue-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .queue-title {
    margin-top: 14px;
    font-size: var(--t-title);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .queue-lead {
    max-width: 560px;
    margin-top: 12px;
    font-size: var(--t-small);
    line-height: 1.65;
    color: var(--text-2);
  }

  .queue-summary .live-dot:not(.is-off) {
    background: var(--accent);
    animation: live-blink 1.6s ease-in-out infinite;
  }

  .queue-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line-soft);
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .queue-offline {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    font-size: var(--t-caption);
    color: var(--text-2);
  }

  .queue-offline[hidden] {
    display: none;
  }

  .build-eta {
    font-size: var(--t-caption);
    color: var(--text-2);
  }

  .queue-root {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .queue-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .queue-section-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .queue-section-head h2 {
    font-size: var(--t-h3);
  }

  .queue-section-head .count {
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .queue-empty {
    font-size: var(--t-small);
    color: var(--text-3);
  }

  .queue-page .icon {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .building {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }

  .build-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-raise);
    color: var(--text);
    transition: border-color 160ms ease;
  }

  .build-card:hover {
    border-color: var(--accent-line);
  }

  .build-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .build-percent {
    font-size: var(--t-caption);
    color: var(--text-2);
  }

  .build-stage {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--t-caption);
    color: var(--text-2);
  }

  .build-stage .live-dot {
    background: var(--accent);
  }

  .build-track {
    height: 4px;
    border-radius: 2px;
    background: var(--panel-2);
    overflow: hidden;
  }

  .build-track span {
    display: block;
    height: 100%;
    background: var(--accent);
    transition: width 600ms var(--ease-out);
  }

  .build-detail {
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .queue-rows {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-soft);
    list-style: none;
  }

  .queue-row {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto 16px;
    align-items: center;
    gap: 14px;
    padding: 14px 6px;
    border-bottom: 1px solid var(--line-soft);
    color: var(--text);
    transition: background-color 140ms ease;
  }

  .queue-row:hover {
    background: var(--panel);
  }

  .row-lead {
    display: grid;
    place-items: center;
    font-size: var(--t-small);
    color: var(--text-3);
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .row-name {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .queue-page .owner {
    color: var(--text-3);
  }

  .row-meta,
  .row-side {
    font-size: var(--t-caption);
    color: var(--text-3);
  }

  .queue-row > .icon {
    color: var(--text-3);
    transition: transform 160ms var(--ease-out);
  }

  .queue-row:hover > .icon {
    transform: translateX(3px);
    color: var(--text);
  }

  @media (max-width: 720px) {
    .queue-head {
      flex-direction: column;
      align-items: flex-start;
    }

    .queue-row {
      grid-template-columns: 28px minmax(0, 1fr) 16px;
    }

    .row-side {
      display: none;
    }
  }
</style>
