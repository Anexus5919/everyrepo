{
  "dataDir": "C:/path/to/everyrepo-data",
  "localRepos": {
    "mui/mui-x": {
      "path": "C:/path/to/mui-x",
      "remote": "upstream",
      "defaultBranch": "master"
    }
  },
  "embeddings": {
    "provider": "workers-ai",
    "model": "@cf/qwen/qwen3-embedding-0.6b",
    "dimensions": 1024,
    "batchSize": 32,
    "dailyNeuronBudget": 9000,
    "concurrency": 4
  },
  "llm": {
    "models": {
      "gemini-flash": {
        "provider": "gemini",
        "model": "gemini-3.8-flash",
        "requestsPerMinute": 5,
        "tokensPerMinute": 250000,
        "requestsPerDay": 18
      },
      "gemini-lite": {
        "provider": "gemini",
        "model": "gemini-3.5-flash-lite",
        "requestsPerMinute": 15,
        "tokensPerMinute": 250000,
        "requestsPerDay": 480
      },
      "groq-oss": {
        "provider": "groq",
        "model": "openai/gpt-oss-120b",
        "requestsPerMinute": 30,
        "tokensPerMinute": 8000,
        "requestsPerDay": 1000
      },
      "groq-qwen": {
        "provider": "groq",
        "model": "qwen/qwen3.8-27b",
        "requestsPerMinute": 30,
        "tokensPerMinute": 8000,
        "requestsPerDay": 1000
      }
    },
    "tasks": {
      "summary": ["gemini-lite", "groq-qwen"],
      "plan": ["gemini-flash", "gemini-lite"],
      "page": ["gemini-lite", "gemini-flash"],
      "ask": ["groq-oss", "groq-qwen", "gemini-lite"]
    }
  }
}
